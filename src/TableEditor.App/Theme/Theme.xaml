<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:v="clr-namespace:TableEditor.App.Views">
    <!-- 색·간격·글자·radius 는 여기에만 둔다(목업 mock.css 의 값). 화면 코드는 키로만 쓴다. -->

    <v:CatBrush x:Key="CatBrush"/>
    <v:MapBrush x:Key="MapBrush"/>
    <v:Indent x:Key="IndentMargin"/>
    <v:Shown x:Key="Shown"/>
    <v:Not x:Key="Not"/>
    <!-- 팝업 처음 포커스 단추 표시(Button.Tag) -->
    <sys:Boolean x:Key="True">True</sys:Boolean>

    <!-- ===== 색 ===== -->
    <Color x:Key="C.Bg">#F3F3F3</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.Well">#F7F7F7</Color>
    <Color x:Key="C.Line">#E6E6E6</Color>
    <Color x:Key="C.Line2">#CFCFCF</Color>
    <Color x:Key="C.LineEdge">#A8A8A8</Color>
    <Color x:Key="C.RowLine">#F0F0F0</Color>
    <Color x:Key="C.Text">#1B1B1B</Color>
    <Color x:Key="C.Text2">#5C5C5C</Color>
    <Color x:Key="C.Text3">#9B9B9B</Color>
    <Color x:Key="C.Accent">#0F6CBD</Color>
    <Color x:Key="C.AccentBg">#EAF2FB</Color>
    <Color x:Key="C.Err">#C42B1C</Color>
    <Color x:Key="C.ErrBg">#FDF1F1</Color>
    <Color x:Key="C.Warn">#8A5300</Color>
    <Color x:Key="C.WarnFill">#F2B200</Color>
    <Color x:Key="C.WarnInk">#3B2600</Color>
    <Color x:Key="C.Chip">#E9E9E9</Color>
    <Color x:Key="C.NavOn">#E4E4E4</Color>
    <Color x:Key="C.Code">#ECECEC</Color>
    <Color x:Key="C.CodeText">#333333</Color>
    <Color x:Key="C.Mark">#CFE3F8</Color>
    <Color x:Key="C.Block">#FBFBFB</Color>
    <Color x:Key="C.Grip">#C4C4C4</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Well" Color="{StaticResource C.Well}"/>
    <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="Line2" Color="{StaticResource C.Line2}"/>
    <SolidColorBrush x:Key="LineEdge" Color="{StaticResource C.LineEdge}"/>
    <SolidColorBrush x:Key="RowLine" Color="{StaticResource C.RowLine}"/>
    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="Text2" Color="{StaticResource C.Text2}"/>
    <SolidColorBrush x:Key="Text3" Color="{StaticResource C.Text3}"/>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentBg" Color="{StaticResource C.AccentBg}"/>
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Err" Color="{StaticResource C.Err}"/>
    <SolidColorBrush x:Key="ErrBg" Color="{StaticResource C.ErrBg}"/>
    <SolidColorBrush x:Key="Warn" Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="WarnFill" Color="{StaticResource C.WarnFill}"/>
    <SolidColorBrush x:Key="Chip" Color="{StaticResource C.Chip}"/>
    <SolidColorBrush x:Key="NavOn" Color="{StaticResource C.NavOn}"/>
    <SolidColorBrush x:Key="Code" Color="{StaticResource C.Code}"/>
    <SolidColorBrush x:Key="CodeText" Color="{StaticResource C.CodeText}"/>
    <SolidColorBrush x:Key="Mark" Color="{StaticResource C.Mark}"/>
    <SolidColorBrush x:Key="BlockBg" Color="{StaticResource C.Block}"/>
    <SolidColorBrush x:Key="Grip" Color="{StaticResource C.Grip}"/>
    <!-- 칸 테: 옆·위는 Line2, 아래 1px 만 진하게(높이 36 기준) -->
    <LinearGradientBrush x:Key="BoxEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource C.Line2}" Offset="0"/>
        <GradientStop Color="{StaticResource C.Line2}" Offset="0.97"/>
        <GradientStop Color="{StaticResource C.LineEdge}" Offset="0.972"/>
        <GradientStop Color="{StaticResource C.LineEdge}" Offset="1"/>
    </LinearGradientBrush>

    <!-- 블록 띠: 분류마다 한 색(빨강·노랑 없음). 키 = "Cat." + 문법 표 팔레트 분류(GrammarEntry.Palette) -->
    <SolidColorBrush x:Key="Cat.정지" Color="#4B5563"/>
    <SolidColorBrush x:Key="Cat.시퀀스" Color="#2F6FB5"/>
    <SolidColorBrush x:Key="Cat.속도·방향" Color="#0F8A8A"/>
    <SolidColorBrush x:Key="Cat.회전" Color="#7A56C2"/>
    <SolidColorBrush x:Key="Cat.분기" Color="#2A9FC9"/>
    <SolidColorBrush x:Key="Cat.보고" Color="#3D8F4F"/>
    <SolidColorBrush x:Key="Cat.장애물" Color="#8A6A4A"/>
    <SolidColorBrush x:Key="Cat.기타" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Cat.출력" Color="#2F6FB5"/>
    <SolidColorBrush x:Key="Cat.벨트" Color="#0F8A8A"/>
    <SolidColorBrush x:Key="Cat.대기" Color="#7A56C2"/>
    <SolidColorBrush x:Key="Cat.주행" Color="#4B5563"/>
    <SolidColorBrush x:Key="Cat.끝" Color="#8A6A4A"/>
<SolidColorBrush x:Key="Cat.raw" Color="#CFCFCF"/>

    <!-- ===== 글자 ===== -->
    <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
    <sys:Double x:Key="Fs.Tiny">12</sys:Double>
    <sys:Double x:Key="Fs.Small">13</sys:Double>
    <sys:Double x:Key="Fs.Mid">14</sys:Double>
    <sys:Double x:Key="Fs.Body">15</sys:Double>
    <sys:Double x:Key="Fs.Tag">16</sys:Double>
    <FontWeight x:Key="Semi">SemiBold</FontWeight>

    <!-- ===== 크기(4의 배수 바탕, 목업 값) ===== -->
    <sys:Double x:Key="TopHeight">60</sys:Double>
    <sys:Double x:Key="BarHeight">60</sys:Double>
    <sys:Double x:Key="RowHeight">44</sys:Double>
    <sys:Double x:Key="HeadHeight">32</sys:Double>
    <sys:Double x:Key="BlockHeight">30</sys:Double>
    <sys:Double x:Key="ControlHeight">36</sys:Double>
    <sys:Double x:Key="ButtonWidth">88</sys:Double>
    <sys:Double x:Key="SmallButtonWidth">80</sys:Double>
    <sys:Double x:Key="SmallButtonHeight">32</sys:Double>
    <sys:Double x:Key="ChipHeight">28</sys:Double>
    <sys:Double x:Key="NavWidth">152</sys:Double>
    <sys:Double x:Key="NavItemHeight">40</sys:Double>
    <sys:Double x:Key="SiteWidth">164</sys:Double>
    <sys:Double x:Key="TagBoxWidth">84</sys:Double>
    <sys:Double x:Key="ProfileBoxWidth">148</sys:Double>
    <sys:Double x:Key="SegWidth">64</sys:Double>
    <sys:Double x:Key="FieldMinWidth">96</sys:Double>
    <sys:Double x:Key="CodeHeight">32</sys:Double>
    <sys:Double x:Key="CheckHeadHeight">36</sys:Double>
    <sys:Double x:Key="CheckRowHeight">32</sys:Double>
    <sys:Double x:Key="CheckListMax">128</sys:Double>
    <sys:Double x:Key="IconSize">16</sys:Double>
    <sys:Double x:Key="BadgeSize">20</sys:Double>
    <sys:Double x:Key="Dot">8</sys:Double>
    <sys:Double x:Key="EmptyButtonWidth">160</sys:Double>
    <sys:Double x:Key="CondMax">124</sys:Double>

    <!-- 줄 표 열: 손잡이, 줄, 태그, 프로파일, 조건, 동작(나머지), 칸, 주석 -->
    <GridLength x:Key="Col.Grip">32</GridLength>
    <GridLength x:Key="Col.No">40</GridLength>
    <GridLength x:Key="Col.Tag">72</GridLength>
    <GridLength x:Key="Col.Profile">148</GridLength>
    <GridLength x:Key="Col.Cond">132</GridLength>
    <GridLength x:Key="Col.Cells">52</GridLength>
    <GridLength x:Key="Col.Comment">184</GridLength>
    <GridLength x:Key="Col.FIcon">28</GridLength>
    <GridLength x:Key="Col.FRule">56</GridLength>

    <Thickness x:Key="Pad.Top">12,0,16,0</Thickness>
    <Thickness x:Key="Pad.Bar">16,0</Thickness>
    <Thickness x:Key="Pad.RowRight">0,0,16,0</Thickness>
    <Thickness x:Key="Pad.Detail">16,12,16,16</Thickness>
    <Thickness x:Key="Pad.Check">16,0</Thickness>
    <Thickness x:Key="Pad.Nav">8,4,8,8</Thickness>
    <Thickness x:Key="Pad.NavItem">12,0</Thickness>
    <Thickness x:Key="Pad.NavLabel">12,8,12,4</Thickness>
    <Thickness x:Key="Pad.Chip">12,0</Thickness>
    <!-- 블록: 띠 4 + 안쪽 8 = 12, 오른쪽 10 = 3 + 값 뒤 간격 7 -->
    <Thickness x:Key="Pad.Block">12,0,3,0</Thickness>
    <sys:Double x:Key="Stripe.W">4</sys:Double>
    <Thickness x:Key="Pad.Box">12,0</Thickness>
    <Thickness x:Key="Gap.R4">0,0,4,0</Thickness>
    <Thickness x:Key="Gap.R6">0,0,6,0</Thickness>
    <Thickness x:Key="Gap.R7">0,0,7,0</Thickness>
    <Thickness x:Key="Gap.R8">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.R12">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.R16">0,0,16,0</Thickness>
    <Thickness x:Key="Gap.L4">4,0,0,0</Thickness>
    <Thickness x:Key="Gap.L12">12,0,0,0</Thickness>
    <Thickness x:Key="Gap.T12">0,12,0,0</Thickness>
    <Thickness x:Key="Gap.B4">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.B8">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Nav">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Group">12,0,8,0</Thickness>
    <Thickness x:Key="Gap.Seg">20,0,0,0</Thickness>
    <Thickness x:Key="NavRule">12,8</Thickness>
    <Thickness x:Key="TextRight8">0,0,8,0</Thickness>
    <Thickness x:Key="TextRight12">0,0,12,0</Thickness>
    <Thickness x:Key="TextRight20">0,0,20,0</Thickness>
    <Thickness x:Key="Grip.Margin">14,0,0,0</Thickness>
    <Thickness x:Key="Pick.Margin">-3</Thickness>
    <!-- 블록 목록은 왼쪽으로 4 넓혀 고른 테(-3)가 잘리지 않게 한다 -->
    <Thickness x:Key="Acts.Margin">-4</Thickness>
    <Thickness x:Key="Acts.Pad">4</Thickness>
    <Thickness x:Key="Pick.Pad">1</Thickness>
    <Thickness x:Key="Bd.1">1</Thickness>
    <Thickness x:Key="Bd.Top">0,1,0,0</Thickness>
    <Thickness x:Key="Bd.Bottom">0,0,0,1</Thickness>
    <Thickness x:Key="Bd.Edge">1,1,1,1</Thickness>
    <Thickness x:Key="Bd.Main">1,1,0,0</Thickness>
    <Thickness x:Key="Bd.Block">4,1,1,1</Thickness>
    <Thickness x:Key="Bd.Badge">2</Thickness>
    <Thickness x:Key="Bd.Pick">2</Thickness>
    <Thickness x:Key="Bd.Focus">1,1,1,2</Thickness>
    <sys:Double x:Key="Bar.W">3</sys:Double>
    <sys:Double x:Key="NavBar.H">16</sys:Double>

    <CornerRadius x:Key="R.4">4</CornerRadius>
    <CornerRadius x:Key="R.8">8</CornerRadius>
    <CornerRadius x:Key="R.Main">8,0,0,0</CornerRadius>
    <CornerRadius x:Key="R.Chip">14</CornerRadius>
    <CornerRadius x:Key="R.Cond">15</CornerRadius>
    <CornerRadius x:Key="R.Badge">10</CornerRadius>
    <CornerRadius x:Key="R.Bar">2</CornerRadius>
    <CornerRadius x:Key="R.Left">4,0,0,4</CornerRadius>
    <CornerRadius x:Key="R.Right">0,4,4,0</CornerRadius>

    <sys:Double x:Key="Dim">0.5</sys:Double>

    <!-- 태그 보기 열: 프로파일, 조건, 줄, 동작(나머지) -->
    <GridLength x:Key="Look.Profile">180</GridLength>
    <GridLength x:Key="Look.Cond">240</GridLength>
    <GridLength x:Key="Look.No">56</GridLength>
    <Thickness x:Key="Look.Pad">16,0</Thickness>

    <!-- 끌기 손잡이: 4×5 칸마다 점 하나(목업 .grip) -->
    <sys:Double x:Key="Grip.W">8</sys:Double>
    <sys:Double x:Key="Grip.H">14</sys:Double>
    <DrawingBrush x:Key="GripDots" TileMode="Tile" Viewport="0,0,4,5" ViewportUnits="Absolute" Viewbox="0,0,4,5" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L4,0 L4,5 L0,5 Z"/>
                <GeometryDrawing Brush="{StaticResource Grip}" Geometry="M3,2.5 A1,1 0 1 1 2.99,2.5 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- 펼침 꺾쇠 -->
    <Geometry x:Key="Chevron">M0,0 L5,5 L10,0</Geometry>
    <sys:Double x:Key="Chev.Stroke">1.5</sys:Double>
    <sys:Double x:Key="Hair">1</sys:Double>
    <GridLength x:Key="TopHeightLength">60</GridLength>
    <GridLength x:Key="NavWidthLength">152</GridLength>

    <!-- ===== 아이콘(목업 svg 그대로) ===== -->
    <DrawingImage x:Key="IconErr">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Err}" Geometry="M7,0.5 A6.5,6.5 0 1 1 6.99,0.5 Z"/>
                <GeometryDrawing Geometry="M4.6,4.6 L9.4,9.4 M9.4,4.6 L4.6,9.4">
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource OnAccent}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Color x:Key="C.Ok">#3D8F4F</Color>
    <SolidColorBrush x:Key="Ok" Color="{StaticResource C.Ok}"/>
    <DrawingImage x:Key="IconOk">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource Ok}" Geometry="M7,0.5 A6.5,6.5 0 1 1 6.99,0.5 Z"/>
                <GeometryDrawing Geometry="M4,7.2 L6.2,9.4 L10,5">
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource OnAccent}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="IconWarn">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{StaticResource WarnFill}" Geometry="M7,1.2 L13.3,12.4 L0.7,12.4 Z">
                    <GeometryDrawing.Pen><Pen Brush="{StaticResource Warn}" Thickness="0.8" LineJoin="Round"/></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M7,5.2 L7,8.8">
                    <GeometryDrawing.Pen><Pen Thickness="1.4" StartLineCap="Round" EndLineCap="Round"><Pen.Brush><SolidColorBrush Color="{StaticResource C.WarnInk}"/></Pen.Brush></Pen></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M7,9.8 A0.8,0.8 0 1 1 6.99,9.8 Z"><GeometryDrawing.Brush><SolidColorBrush Color="{StaticResource C.WarnInk}"/></GeometryDrawing.Brush></GeometryDrawing>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 L14,0 L14,14 L0,14 Z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ===== 글 스타일 ===== -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}"/>
        <Setter Property="Foreground" Value="{StaticResource Text2}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="T.Faint" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    </Style>
    <Style x:Key="T.Head" TargetType="TextBlock" BasedOn="{StaticResource T.Faint}"/>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="T.Empty" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Icon" TargetType="Image">
        <Setter Property="Width" Value="{StaticResource IconSize}"/>
        <Setter Property="Height" Value="{StaticResource IconSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== 버튼 ===== -->
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{StaticResource ButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bd.1}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.4}">
                            <Border x:Name="Edge" BorderBrush="{StaticResource LineEdge}" BorderThickness="{StaticResource Bd.Bottom}" CornerRadius="{StaticResource R.4}" Margin="-1"/>
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        <Border x:Name="Focus" BorderBrush="{StaticResource Text}" BorderThickness="{StaticResource Bd.Pick}" CornerRadius="{StaticResource R.4}" Margin="-3" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Well}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Line}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 강조 = 색만(크기 같음) -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
    </Style>
    <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
    </Style>
    <Style x:Key="Btn.Small" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Width" Value="{StaticResource SmallButtonWidth}"/>
        <Setter Property="Height" Value="{StaticResource SmallButtonHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource Fs.Mid}"/>
    </Style>

    <!-- 글이 긴 줄(프로파일 삭제 등): 그 줄 단추 모두 이 폭 -->
    <Style x:Key="Btn.Wide" TargetType="Button" BasedOn="{StaticResource Btn.Small}">
        <Setter Property="Width" Value="104"/>
    </Style>

    <!-- 오류 수 배지 -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="MinWidth" Value="{StaticResource BadgeSize}"/>
        <Setter Property="Height" Value="{StaticResource BadgeSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Badge}"/>
        <Setter Property="Background" Value="{StaticResource Err}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Bg}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bd.Badge}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,-7,-7,0"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Tiny}"/>
        <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0"/>
    </Style>

    <!-- 위 줄 칩 -->
    <Style x:Key="TopChip" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource ChipHeight}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Chip}"/>
        <Setter Property="Background" Value="{StaticResource Chip}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Chip}"/>
        <Setter Property="Margin" Value="{StaticResource Gap.R8}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextElement.FontSize" Value="{StaticResource Fs.Small}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource Text2}"/>
    </Style>
    <Style x:Key="ChipValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== 입력 칸 ===== -->
    <Style x:Key="Box" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>
    <Style x:Key="Drop" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 읽기 전용 칸(선택 줄): 상자 모양 + 값 + 작은 단위 -->
    <Style x:Key="FieldBox" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
        <Setter Property="MinWidth" Value="{StaticResource FieldMinWidth}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BoxEdge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bd.1}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.4}"/>
