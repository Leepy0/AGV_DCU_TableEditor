<UserControl x:Class="TableEditor.App.Views.SeqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TableEditor.App.Views"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine">
    <!-- 시퀀스(사양 9.2절, 1차): 왼쪽 나무 + 가운데 스텝 블록 목록. 숫자·시간 칸만 아래 선택 줄에서 고친다 -->
    <UserControl.Resources>
        <DataTemplate x:Key="NodeT" DataType="vm:TreeItemVm">
            <Grid x:Name="Row" Height="{StaticResource TreeRowHeight}" Background="Transparent">
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <DockPanel x:Name="Body" Margin="{StaticResource Tree.L0}">
                    <Image x:Name="Ico" DockPanel.Dock="Right" Style="{StaticResource Icon}" Source="{StaticResource IconErr}" Visibility="Collapsed" Margin="{StaticResource Gap.L4}"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Style="{StaticResource RowNo}" Margin="{StaticResource Gap.L4}"/>
                    <TextBlock x:Name="T" Text="{Binding Text}" ToolTip="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource Fs.Small}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text2}"/>
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter TargetName="Body" Property="Margin" Value="{StaticResource Tree.L1}"/>
                    <Setter TargetName="T" Property="FontFamily" Value="{StaticResource Mono}"/>
                    <Setter TargetName="T" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTable}" Value="True">
                    <Setter TargetName="T" Property="FontFamily" Value="{StaticResource Mono}"/>
                    <Setter TargetName="T" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="T" Property="FontSize" Value="{StaticResource Fs.Mid}"/>
                    <Setter TargetName="T" Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter TargetName="Row" Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter TargetName="Body" Property="Margin" Value="{StaticResource Tree.L2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="T" Property="FontWeight" Value="{StaticResource Semi}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StepT" DataType="vm:StepRowVm">
            <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.RowRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                        <ColumnDefinition Width="{StaticResource Col.No}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.State}"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource ChangeDot}" Height="{StaticResource ChangeDot}" Fill="{StaticResource Accent}" Margin="{StaticResource Gap.R4}"
                                 VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding OrdinalText}" Style="{StaticResource RowNo}"/>
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="{Binding Level, Converter={StaticResource IndentMargin}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.SelLine}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 분기 묶음 선 -->
                        <Border x:Name="Sel" Width="{StaticResource SelectLine}" HorizontalAlignment="Left" Background="{StaticResource Line2}" Visibility="Collapsed"/>
                        <!-- 라벨 이름표 -->
                        <Border x:Name="Tag" Grid.Column="1" Height="{StaticResource LabelTagHeight}" CornerRadius="{StaticResource R.Tag}" Background="{StaticResource AccentBg}"
                                Padding="{StaticResource Pad.LabelTag}" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Small}" FontWeight="{StaticResource Semi}"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter x:Name="Blk" Grid.Column="1" Content="{Binding Block}" ContentTemplate="{StaticResource BlockT}" HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="3">
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Status, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource Shown}}">
                            <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                            <TextBlock x:Name="StText" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLabel}" Value="True">
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Blk" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InSelect}" Value="True">
                    <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectTop}" Value="True">
                    <Setter TargetName="Sel" Property="Margin" Value="{StaticResource Sel.Top}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectBottom}" Value="True">
                    <Setter TargetName="Sel" Property="Margin" Value="{StaticResource Sel.Bottom}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SelectTop}" Value="True"/>
                        <Condition Binding="{Binding SelectBottom}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Sel" Property="Margin" Value="{StaticResource Sel.Both}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Err}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource TreeWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 위 줄: 고른 표 이름 + 스텝 수 -->
        <DockPanel Grid.ColumnSpan="2" Height="{StaticResource BarHeight}" Margin="{StaticResource Pad.Bar}" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="표" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.R8}"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding TableTitle}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Tag}" FontWeight="{StaticResource Semi}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StepCount}" Style="{StaticResource T.Faint}"/>
        </DockPanel>

        <Grid Grid.Row="1" Height="{StaticResource HeadHeight}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <TextBlock Text="프로파일 · ID · 표" Style="{StaticResource HeadCell}" Margin="{StaticResource Tree.L0}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1" Height="{StaticResource HeadHeight}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <Grid Margin="{StaticResource Pad.RowRight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                    <ColumnDefinition Width="{StaticResource Col.No}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Col.State}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="줄" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}"/>
                <TextBlock Grid.Column="2" Text="스텝" Style="{StaticResource HeadCell}" Margin="{StaticResource Sel.Pad}"/>
                <TextBlock Grid.Column="3" Text="주석" Style="{StaticResource HeadCell}"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ListBox x:Name="TreeList" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}" ItemsSource="{Binding Tree}"
                     ItemTemplate="{StaticResource NodeT}" SelectedItem="{Binding Node}" AutomationProperties.Name="시퀀스 나무"/>
        </Border>
        <ListBox x:Name="StepList" Grid.Row="2" Grid.Column="1" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}"
                 ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepT}" SelectedItem="{Binding SelectedStep}" AutomationProperties.Name="스텝"/>
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="표 없음" Style="{StaticResource T.Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}"/>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource Well}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}"
                Padding="{StaticResource Pad.Detail}" Visibility="{Binding HasStep, Converter={StaticResource Shown}}">
            <StackPanel>
                <DockPanel Height="{StaticResource SmallButtonHeight}" Margin="{StaticResource Gap.B8}">
                    <TextBlock Style="{StaticResource T.Label}">
                        <Run Text="{Binding DetailTitle, Mode=OneWay}"/><Run Text="{Binding DetailHead, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/>
                    </TextBlock>
                </DockPanel>
                <v:DetailView/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
