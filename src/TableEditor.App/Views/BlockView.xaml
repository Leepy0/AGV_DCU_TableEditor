<UserControl x:Class="TableEditor.App.Views.BlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:TableEditor.App.Blocks"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine">
    <!-- 블록 하나 = 테 있는 칩 하나: 왼쪽 띠 = 분류 색, 머리 = 한글 이름(굵게), 인자 = 옅은 칸마다 하나(Shared.xaml ArgPill·ArgValue).
         문법 표의 칸만 보고 그린다(매크로별 화면 없음). 태그 동작·시퀀스 스텝·수동 출력이 같이 쓴다 -->
    <Grid x:Name="Root" Cursor="Hand">
        <Grid.InputBindings>
            <MouseBinding Gesture="LeftClick" Command="{Binding Pick}"/>
        </Grid.InputBindings>
        <Border x:Name="Ring" Margin="{StaticResource Pick.Margin}" BorderThickness="{StaticResource Bd.Pick}" CornerRadius="{StaticResource R.8}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border Height="{StaticResource BlockHeight}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource BlockBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Raw}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Code}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPicked}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Surface}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mark}" Value="{x:Static chk:Severity.Warning}">
                            <Setter Property="BorderBrush" Value="{StaticResource WarnFill}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mark}" Value="{x:Static chk:Severity.Error}">
                            <Setter Property="BorderBrush" Value="{StaticResource Err}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border Width="{StaticResource Stripe.W}" HorizontalAlignment="Left" CornerRadius="{StaticResource R.Left}"
                Background="{Binding Cat, Converter={StaticResource CatBrush}}"/>
        <StackPanel Orientation="Horizontal" Margin="{StaticResource Pad.Block}" VerticalAlignment="Center"
                    TextElement.FontSize="{StaticResource Fs.Mid}" TextElement.Foreground="{StaticResource Text}">
            <TextBlock Text="{Binding Head}" FontWeight="{StaticResource Semi}" Margin="{StaticResource Gap.R7}" VerticalAlignment="Center"
                       Visibility="{Binding Head, Converter={StaticResource Shown}}"/>
            <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="b:Part">
                        <Border Style="{StaticResource ArgPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource BlockSmall}" Visibility="{Binding Label, Converter={StaticResource Shown}}"/>
                                <TextBlock Text="{Binding Value}" Style="{StaticResource ArgValue}"/>
                                <TextBlock Text="{Binding Small}" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L4}" Visibility="{Binding Small, Converter={StaticResource Shown}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>
