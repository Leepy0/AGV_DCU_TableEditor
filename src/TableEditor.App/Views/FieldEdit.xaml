<UserControl x:Class="TableEditor.App.Views.FieldEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:TableEditor.App.Blocks">
    <!-- 칸 편집기 하나(DataContext = FieldVm): 이름·낱말 드롭다운 / 숫자·글 상자 / 읽기 전용. 선택 줄 칸과 표 안 칸 편집이 같이 쓴다 -->
    <Grid>
        <ComboBox x:Name="List" MinWidth="{StaticResource FieldMinWidth}" ItemsSource="{Binding Items}" SelectedItem="{Binding Picked}"
                  Visibility="{Binding IsList, Converter={StaticResource Shown}}" GotKeyboardFocus="OnFocus" AutomationProperties.Name="{Binding Label}">
            <ComboBox.Style>
                <Style TargetType="ComboBox" BasedOn="{StaticResource Drop}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHot}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ComboBox.Style>
            <ComboBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Faint}" FontSize="{StaticResource Fs.Tiny}" Margin="{StaticResource Pad.NavLabel}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ComboBox.GroupStyle>
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="b:Choice">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Note}" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L12}"
                                   Visibility="{Binding Note, Converter={StaticResource Shown}}"/>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <!-- 대응표가 없는 시퀀스 ID: 흐리게(고를 수는 있다) -->
                        <DataTrigger Binding="{Binding Group}" Value="연결 없음">
                            <Setter Property="Opacity" Value="{StaticResource Dim}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid Visibility="{Binding IsBox, Converter={StaticResource Shown}}" MinWidth="{StaticResource FieldMinWidth}">
            <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     GotKeyboardFocus="OnFocus" LostKeyboardFocus="OnLost" AutomationProperties.Name="{Binding Label}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource EditBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mono}" Value="True">
                                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Small, Converter={StaticResource Shown}}" Value="Visible">
                                <Setter Property="Padding" Value="{StaticResource Pad.BoxSmall}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsHot}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="BorderThickness" Value="{StaticResource Bd.Focus}"/>
                            </DataTrigger>
                            <!-- 틀린 값: 빨간 테 + 빨간 글(포커스 중에도 보인다). 확정하지 않는다 -->
                            <DataTrigger Binding="{Binding Invalid}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Err}"/>
                                <Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/>
                                <Setter Property="Foreground" Value="{StaticResource Err}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CommitCmd}"/>
                    <KeyBinding Key="Escape" Command="{Binding RevertCmd}"/>
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding Small}" Style="{StaticResource T.Faint}" HorizontalAlignment="Right" Margin="{StaticResource TextRight12}"
                       IsHitTestVisible="False" Visibility="{Binding Small, Converter={StaticResource Shown}}"/>
        </Grid>
        <!-- 읽기 전용: 상자 모양 + 값(흐린 바탕) -->
        <Border Style="{StaticResource FieldBox}" Background="{StaticResource Well}" Visibility="{Binding Locked, Converter={StaticResource Shown}}"
                ToolTip="{Binding Text}">
            <TextBlock Text="{Binding Shown}" Foreground="{StaticResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
