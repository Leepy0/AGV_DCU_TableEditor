<UserControl x:Class="TableEditor.App.Views.ManualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TableEditor.App.Views"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine"
             x:Name="Me">
    <!-- 수동(사양 9.2절): 프로파일별 사슬 카드(모드 + 가지 줄 + 끝 줄), 따로 입력 줄. 줄 모양·블록·칩은 태그 화면과 같다 -->
    <UserControl.Resources>
        <!-- 가지·끝·입력 줄 -->
        <DataTemplate x:Key="ManRowT" DataType="vm:ManRowVm">
            <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent" AllowDrop="True" Drop="OnRowDrop">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.Pick, ElementName=Me}" CommandParameter="{Binding}"/>
                </Grid.InputBindings>
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="0,1,0,0"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.RowRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                        <ColumnDefinition Width="{StaticResource Col.No}"/>
                        <ColumnDefinition Width="{StaticResource Col.Branch}"/>
                        <ColumnDefinition Width="{StaticResource Col.Arrow}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.State}"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Grip" Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" ToolTip="끌기">
                        <Rectangle Width="{StaticResource Grip.W}" Height="{StaticResource Grip.H}" Fill="{StaticResource GripDots}"
                                   HorizontalAlignment="Left" Margin="{StaticResource Grip.Margin}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource ChangeDot}" Height="{StaticResource ChangeDot}" Fill="{StaticResource Accent}" Margin="{StaticResource Gap.R4}"
                                 VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding OrdinalText}" Style="{StaticResource RowNo}"/>
                    </StackPanel>
                    <!-- 조건(가지) 또는 머리 글(그 외·입력 줄) -->
                    <Grid x:Name="Cond" Grid.Column="2" ClipToBounds="True" Background="Transparent" Cursor="Hand" ToolTip="조건">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.EditCond, ElementName=Me}" CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource WideChipT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="Head" Grid.Column="2" Text="{Binding Head}" Style="{StaticResource T.Faint}" FontSize="{StaticResource Fs.Mid}" Visibility="Collapsed"/>
                    <TextBlock x:Name="Arrow" Grid.Column="3" Text="→" Style="{StaticResource T.Faint}" HorizontalAlignment="Center"/>
                    <DockPanel x:Name="Outs" Grid.Column="4" ClipToBounds="True" Margin="{StaticResource Acts.Margin}" LastChildFill="False">
                        <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource BlockT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center" Padding="{StaticResource Acts.Pad}"/>
                        <Button x:Name="PlusBtn" Content="+" Style="{StaticResource Plus}" Click="OnPlus" Visibility="Collapsed" ToolTip="출력 추가"
                                AutomationProperties.Name="출력 추가"/>
                    </DockPanel>
                    <Grid Grid.Column="5">
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Status, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource Shown}}">
                            <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                            <TextBlock x:Name="StText" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsElse}" Value="True">
                    <Setter TargetName="Cond" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Head" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInput}" Value="True">
                    <Setter TargetName="Cond" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Head" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Head" Property="Foreground" Value="{StaticResource Text2}"/>
                    <Setter TargetName="Grip" Property="Visibility" Value="Hidden"/>
                    <Setter TargetName="Arrow" Property="Visibility" Value="Hidden"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrBg}"/>
                    <Setter TargetName="Cond" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Outs" Property="Opacity" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Outs" Property="Opacity" Value="1"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True"/>
                        <Condition Binding="{Binding IsInput}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="PlusBtn" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 사슬 카드 -->
        <DataTemplate x:Key="CardT" DataType="vm:CardVm">
            <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}"
                    CornerRadius="{StaticResource R.8}" Margin="{StaticResource Gap.Card}" ClipToBounds="True" AllowDrop="True" Drop="OnCardDrop">
                <Grid>
                    <Border x:Name="Band" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                    <StackPanel>
                        <Grid Height="{StaticResource CardHeadHeight}" Margin="{StaticResource Pad.CardHead}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="OnCardGripDown" MouseMove="OnCardGripMove" ToolTip="사슬 끌기">
                                <Rectangle Width="{StaticResource Grip.W}" Height="{StaticResource Grip.H}" Fill="{StaticResource GripDots}"
                                           HorizontalAlignment="Left" Margin="{StaticResource Grip.Margin}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Profile}" Style="{StaticResource ProfileHead}" Margin="{StaticResource Gap.Group}"/>
                            <ComboBox Grid.Column="2" Style="{StaticResource CellDrop}" Margin="{StaticResource Gap.R12}" MinWidth="{StaticResource FieldMinWidth}"
                                      ItemsSource="{Binding Source={x:Static vm:ManualVm.Modes}}" SelectedItem="{Binding ModeDraft}" AutomationProperties.Name="모드"/>
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource T.Faint}"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{Binding Status}" MaxWidth="{StaticResource TemplateWidth}"
                                        Visibility="{Binding Status, Converter={StaticResource Shown}}">
                                <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                                <TextBlock x:Name="StText" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ManRowT}" Focusable="False"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Line2}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="Band" Property="Background" Value="{StaticResource Err}"/>
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Err}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Height="{StaticResource BarHeight}" Margin="{StaticResource Pad.Bar}" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="프로파일" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.R8}"/>
            <ComboBox DockPanel.Dock="Left" Style="{StaticResource Drop}" MinWidth="{StaticResource ProfileBoxWidth}" VerticalAlignment="Center"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="프로파일 거르기"/>
            <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding AddCard}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Faint}" Margin="{StaticResource Gap.R12}"/>
        </DockPanel>

        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <StackPanel Margin="{StaticResource Pad.Cards}" AllowDrop="True" Drop="OnCardsDrop" Background="Transparent">
                <ItemsControl x:Name="CardList" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardT}" Focusable="False" AutomationProperties.Name="사슬 카드"/>
                <!-- 따로: 방향 전환 스위치·후방 장애물 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.8}"
                        ClipToBounds="True" Visibility="{Binding HasInputs, Converter={StaticResource Shown}}">
                    <StackPanel>
                        <Grid Height="{StaticResource CardHeadHeight}">
                            <TextBlock Text="입력" FontWeight="{StaticResource Semi}" VerticalAlignment="Center" Margin="{StaticResource Pad.InputHead}"/>
                        </Grid>
                        <ItemsControl x:Name="InputList" ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource ManRowT}" Focusable="False" AutomationProperties.Name="입력 줄"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}">
            <TextBlock Text="카드 없음" Style="{StaticResource EmptyWord}"/>
            <Button Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding AddCard}"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Well}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}"
                Padding="{StaticResource Pad.Detail}" Visibility="{Binding HasSelection, Converter={StaticResource Shown}}">
            <StackPanel>
                <DockPanel Height="{StaticResource SmallButtonHeight}" Margin="{StaticResource Gap.B8}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="가지 추가" Style="{StaticResource Btn.Wide}" Command="{Binding AddBranch}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="블록 삭제" Style="{StaticResource Btn.Wide}" Command="{Binding DeleteBlock}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="줄 삭제" Style="{StaticResource Btn.Wide}" Command="{Binding DeleteRow}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="카드 삭제" Style="{StaticResource Btn.Wide}" Command="{Binding DeleteCard}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource T.Label}">
                        <Run Text="{Binding DetailTitle, Mode=OneWay}"/><Run Text="{Binding DetailHead, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/>
                    </TextBlock>
                </DockPanel>
                <v:DetailView/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
