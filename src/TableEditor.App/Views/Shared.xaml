<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TableEditor.App.Views"
                    xmlns:b="clr-namespace:TableEditor.App.Blocks">
    <!-- 표 화면들이 같이 쓰는 틀(칩, 블록, 가로 목록, 줄 머리 글). 색·크기는 Theme 의 키로만 -->

    <!-- 조건 칩: 머리(보조 글) + 값(굵게) -->
    <DataTemplate x:Key="ChipT" DataType="b:Chip">
        <Border Style="{StaticResource Cond}" ToolTip="{Binding Full}">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Head}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Text}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}" VerticalAlignment="Center"
                           Margin="{StaticResource Gap.L4}" TextTrimming="CharacterEllipsis" Visibility="{Binding Text, Converter={StaticResource Shown}}"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- 넓은 칸의 칩(적재, 수동 조건): 말줄임 한계만 넓다 -->
    <DataTemplate x:Key="WideChipT" DataType="b:Chip">
        <Border Style="{StaticResource Cond}" MaxWidth="{StaticResource CondWideMax}" ToolTip="{Binding Full}">
            <DockPanel VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Head}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Text}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}" VerticalAlignment="Center"
                           Margin="{StaticResource Gap.L4}" TextTrimming="CharacterEllipsis" Visibility="{Binding Text, Converter={StaticResource Shown}}"/>
            </DockPanel>
        </Border>
    </DataTemplate>

    <!-- 프로파일 묶음: 머리 줄의 프로파일 이름(굵게) + 묶음 사이 구분선(진한 선). 태그 보기·시퀀스 나무·수동 카드가 같이 쓴다 -->
    <Style x:Key="ProfileHead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Body}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="ProfileRule" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineEdge}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Bd.Top}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>

    <ItemsPanelTemplate x:Key="Across"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>

    <!-- 블록(동작 하나·스텝 하나) 안 인자 하나: 옅은 칸. 명령 이름은 칸 밖 굵은 글. 원문 블록은 칸 없이 -->
    <Style x:Key="ArgPill" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource PillHeight}"/>
        <Setter Property="Padding" Value="{StaticResource Pad.Pill}"/>
        <Setter Property="Margin" Value="{StaticResource Gap.Pill}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.4}"/>
        <Setter Property="Background" Value="{StaticResource Chip}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.Raw, RelativeSource={RelativeSource AncestorType=v:BlockView}}" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- 인자 값. 켬/끔 칸은 ON = 초록 굵게, OFF = 흐리게 -->
    <Style x:Key="ArgValue" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding On}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ok}"/>
                <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding On}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource Text3}"/>
                <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.Raw, RelativeSource={RelativeSource AncestorType=v:BlockView}}" Value="True">
                <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
                <Setter Property="FontSize" Value="{StaticResource Fs.Small}"/>
                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BlockT" DataType="b:BlockVm">
        <v:BlockView Margin="{StaticResource Gap.R6}"/>
    </DataTemplate>
    <DataTemplate x:Key="LookBlockT" DataType="b:BlockVm">
        <v:BlockView Margin="{StaticResource Gap.R6}" IsHitTestVisible="False"/>
    </DataTemplate>

    <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource T.Head}"/>

    <!-- 줄 상태 글: 아이콘 + 글(경고 색). 오류면 화면이 아이콘·색을 바꾼다 -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Fs.Small}"/>
        <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
        <Setter Property="Foreground" Value="{StaticResource Warn}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 줄 번호(흐린 고정폭) -->
    <Style x:Key="RowNo" TargetType="TextBlock" BasedOn="{StaticResource T.Faint}">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    </Style>

    <!-- 빈 표: 낱말 하나 + [추가] -->
    <Style x:Key="EmptyWord" TargetType="TextBlock" BasedOn="{StaticResource T.Empty}">
        <Setter Property="Margin" Value="{StaticResource Gap.B16}"/>
    </Style>
</ResourceDictionary>
