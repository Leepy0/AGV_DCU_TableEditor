<UserControl x:Class="TableEditor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- 설정(사양 9.2절): 라벨 + 값. 바꾸면 바로 저장 -->
    <UserControl.Resources>
        <Style x:Key="SetLabel" TargetType="TextBlock" BasedOn="{StaticResource FrowLabel}"/>
        <Style x:Key="SetBox" TargetType="TextBox" BasedOn="{StaticResource EditBox}">
            <Setter Property="Width" Value="{StaticResource SettingsBox}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <!-- 업데이트 단추 줄: 같은 폭, 지금 누를 단추(Tag = true)만 강조 색 -->
        <Style x:Key="UpdBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Width" Value="{StaticResource WideButtonWidth}"/>
            <Setter Property="Margin" Value="{StaticResource Gap.R8}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <DataTrigger.Value><sys:Boolean>True</sys:Boolean></DataTrigger.Value>
                    <Setter Property="Background" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
                    <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Pad.Settings}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Set.Label}"/>
                <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="저장소 폴더" Style="{StaticResource SetLabel}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource Gap.B16}">
                <TextBox Style="{StaticResource SetBox}" Text="{Binding RepoFolder, Mode=OneWay}" IsReadOnly="True" Margin="{StaticResource Gap.R8}"
                         AutomationProperties.Name="저장소 폴더"/>
                <Button Content="폴더" Style="{StaticResource Btn}" Command="{Binding PickRepo}"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="앱 주소" Style="{StaticResource SetLabel}"/>
            <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource SetBox}" Text="{Binding AppUrl, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.B16}"
                     AutomationProperties.Name="앱 주소"/>

            <TextBlock Grid.Row="2" Text="코어 주소" Style="{StaticResource SetLabel}"/>
            <TextBox Grid.Row="2" Grid.Column="2" Style="{StaticResource SetBox}" Text="{Binding CoreUrl, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.B16}"
                     AutomationProperties.Name="코어 주소"/>

            <TextBlock Grid.Row="3" Text="gcc" Style="{StaticResource SetLabel}"/>
            <TextBox Grid.Row="3" Grid.Column="2" Style="{StaticResource SetBox}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Small}"
                     Text="{Binding GccPath, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.B16}" AutomationProperties.Name="gcc"/>

            <TextBlock Grid.Row="4" Text="cl2000" Style="{StaticResource SetLabel}"/>
            <TextBox Grid.Row="4" Grid.Column="2" Style="{StaticResource SetBox}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Small}"
                     Text="{Binding Cl2000Path, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.B16}" AutomationProperties.Name="cl2000"/>

            <TextBlock Grid.Row="5" Text="도구" Style="{StaticResource SetLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
            <StackPanel Grid.Row="5" Grid.Column="2" Margin="{StaticResource Gap.B16}">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left"
                        Width="{StaticResource SettingsBox}">
                    <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ToolRow}">
                                <Grid Height="{StaticResource CheckRowHeight}" Margin="{StaticResource Pad.Check}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Col.FIcon}"/>
                                        <ColumnDefinition Width="{StaticResource Matrix.Tag}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image x:Name="Ico" Style="{StaticResource Icon}" Source="{StaticResource IconOk}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource Fs.Mid}" FontWeight="{StaticResource Semi}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="T" Grid.Column="2" Text="{Binding Text}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Found}" Value="False">
                                        <Setter TargetName="Ico" Property="Source" Value="{StaticResource IconErr}"/>
                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource Err}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.T8}">
                    <Button Content="{Binding ProbeText}" Style="{StaticResource Btn.Small}" Command="{Binding Probe}" Margin="{StaticResource Gap.R12}"/>
                    <TextBlock Text="{Binding ProbedAt}" Style="{StaticResource T.Faint}" VerticalAlignment="Center" Visibility="{Binding ProbedAt, Converter={StaticResource Shown}}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="6" Text="이름" Style="{StaticResource SetLabel}"/>
            <TextBox Grid.Row="6" Grid.Column="2" Style="{StaticResource SetBox}" Text="{Binding UserName, UpdateSourceTrigger=LostFocus}" Margin="{StaticResource Gap.B16}"
                     AutomationProperties.Name="이름"/>

            <TextBlock Grid.Row="7" Text="고급 모드" Style="{StaticResource SetLabel}"/>
            <Border Grid.Row="7" Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                    CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="끔" Style="{StaticResource Seg}" GroupName="Adv" IsChecked="{Binding Advanced, Converter={StaticResource Not}}"/>
                    <RadioButton Content="켬" Style="{StaticResource Seg}" GroupName="Adv" IsChecked="{Binding Advanced}"/>
                </StackPanel>
            </Border>

            <!-- 코어: 지금 버전 + [코어 올리기](사양 8.6절) -->
            <TextBlock Grid.Row="8" Text="코어" Style="{StaticResource SetLabel}"/>
            <StackPanel Grid.Row="8" Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource Gap.B16}">
                <Border Style="{StaticResource FieldBox}" Width="{StaticResource SettingsBox}" Margin="{StaticResource Gap.R8}">
                    <TextBlock Text="{Binding DataContext.CoreVersion, RelativeSource={RelativeSource AncestorType=Window}, TargetNullValue=—}" FontWeight="{StaticResource Semi}"
                               VerticalAlignment="Center"/>
                </Border>
                <Button Content="코어 올리기" Style="{StaticResource Btn}" Width="{StaticResource WideButtonWidth}"
                        Command="{Binding DataContext.UpdateCore, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>

            <!-- 프로그램: 버전 · 채널 · 커밋 -->
            <TextBlock Grid.Row="9" Text="프로그램" Style="{StaticResource SetLabel}"/>
            <Border Grid.Row="9" Grid.Column="2" Style="{StaticResource FieldBox}" Width="{StaticResource SettingsBox}" HorizontalAlignment="Left"
                    Margin="{StaticResource Gap.B16}">
                <TextBlock Text="{Binding Update.BuildText}" Style="{StaticResource T.Mono}" VerticalAlignment="Center" AutomationProperties.Name="프로그램 버전"/>
            </Border>

            <!-- 업데이트: [지금 확인][받기][닫고 적용][버리기][되돌리기] + 상태 칩 + 진행률 -->
            <TextBlock Grid.Row="10" Text="업데이트" Style="{StaticResource SetLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
            <StackPanel Grid.Row="10" Grid.Column="2" Margin="{StaticResource Gap.B16}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="지금 확인" Style="{StaticResource UpdBtn}" Command="{Binding Update.CheckNow}" Tag="{Binding Update.CheckPrimary}"/>
                    <Grid>
                        <Button Content="받기" Style="{StaticResource UpdBtn}" Command="{Binding Update.Download}" Tag="{Binding Update.DownloadPrimary}"
                                Visibility="{Binding Update.IsDownloading, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <Button Content="받기 취소" Style="{StaticResource UpdBtn}" Command="{Binding Update.CancelDownload}"
                                Visibility="{Binding Update.IsDownloading, Converter={StaticResource Shown}}"/>
                    </Grid>
                    <Button Content="닫고 적용" Style="{StaticResource UpdBtn}" Command="{Binding Update.ApplyNow}" Tag="{Binding Update.ApplyPrimary}"/>
                    <Button Content="버리기" Style="{StaticResource UpdBtn}" Command="{Binding Update.DiscardPending}"/>
                    <Button Content="되돌리기" Style="{StaticResource UpdBtn}" Command="{Binding Update.Rollback}" ToolTip="{Binding Update.OldVersion}"/>
                    <Border AutomationProperties.Name="업데이트 상태">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TopChip}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Update.ChipAccent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Update.ChipText}" FontWeight="{StaticResource Semi}" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <ProgressBar Width="{StaticResource SettingsBox}" HorizontalAlignment="Left" Height="{StaticResource Bar.W}" Margin="{StaticResource Gap.T8}"
                             Maximum="100" Value="{Binding Update.Progress, Mode=OneWay}" Visibility="{Binding Update.IsDownloading, Converter={StaticResource Shown}}"/>
            </StackPanel>

            <TextBlock Grid.Row="11" Text="자동 확인" Style="{StaticResource SetLabel}"/>
            <Border Grid.Row="11" Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                    CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="끔" Style="{StaticResource Seg}" GroupName="UpdAuto" IsChecked="{Binding Update.AutoCheck, Converter={StaticResource Not}}"/>
                    <RadioButton Content="켬" Style="{StaticResource Seg}" GroupName="UpdAuto" IsChecked="{Binding Update.AutoCheck}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
