<UserControl x:Class="TableEditor.App.Views.IoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine">
    <!-- IO 맵(사양 9.2절, 1차 읽기 전용): 입력·출력 32줄씩(줄 = 코어 ID), 별칭 칩 + 쓰인 곳 수, 미연결, 벨트 -->
    <UserControl.Resources>
        <!-- 별칭 칩: 이름 + (핀 1) + 쓰인 곳 수 -->
        <DataTemplate x:Key="AliasT" DataType="vm:AliasVm">
            <Border x:Name="B" Style="{StaticResource Tok}" ToolTip="{Binding Tip}" BorderThickness="{StaticResource Bd.1}" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    <TextBlock Text="핀 1" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L4}" Foreground="{StaticResource Accent}"
                               Visibility="{Binding High, Converter={StaticResource Shown}}"/>
                    <TextBlock Text="{Binding UsesText}" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L4}" ToolTip="쓰인 곳"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static chk:Severity.Warning}">
                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource WarnFill}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mark}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Err}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="IoRowT" DataType="vm:IoRowVm">
            <Grid x:Name="Row" MinHeight="{StaticResource RowHeight}">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.IoRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.IoId}"/>
                        <ColumnDefinition Width="{StaticResource Col.IoCore}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource RowNo}" HorizontalAlignment="Right" Margin="{StaticResource TextRight12}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Core}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Small}" Foreground="{StaticResource Text2}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Core}"/>
                    <!-- 별칭이 많으면 줄을 바꿔 모두 보인다. 주석은 그 아래 한 줄 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Aliases}" ItemTemplate="{StaticResource AliasT}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Faint}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Comment, Converter={StaticResource Shown}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasAliases}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="HeadT">
            <Grid Height="{StaticResource HeadHeight}">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.IoId}"/>
                        <ColumnDefinition Width="{StaticResource Col.IoCore}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight12}"/>
                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource HeadCell}"/>
                    <TextBlock Grid.Column="2" Text="별칭" Style="{StaticResource HeadCell}"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="{StaticResource Pad.Io}">
            <DockPanel Height="{StaticResource BarHeight}" LastChildFill="False">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Faint}"/>
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="{StaticResource Gap.IoCol}">
                    <ContentPresenter Content="입력" ContentTemplate="{StaticResource HeadT}"/>
                    <ItemsControl x:Name="In" ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource IoRowT}" Focusable="False" AutomationProperties.Name="입력"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <ContentPresenter Content="출력" ContentTemplate="{StaticResource HeadT}"/>
                    <ItemsControl x:Name="Out" ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource IoRowT}" Focusable="False" AutomationProperties.Name="출력"/>
                </StackPanel>
            </Grid>

            <!-- 미연결 -->
            <StackPanel Visibility="{Binding HasUnwired, Converter={StaticResource Shown}}">
                <TextBlock Text="미연결" Style="{StaticResource HeadCell}" Margin="{StaticResource Gap.Section}"/>
                <ItemsControl ItemsSource="{Binding Unwired}" ItemTemplate="{StaticResource AliasT}" Focusable="False" AutomationProperties.Name="미연결">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- 벨트 -->
            <StackPanel Visibility="{Binding HasBelts, Converter={StaticResource Shown}}">
                <Grid Height="{StaticResource HeadHeight}" Margin="{StaticResource Gap.Section}">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Belt}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="벨트" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="1" Text="CW" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="2" Text="CCW" Style="{StaticResource HeadCell}"/>
                    </Grid>
                </Grid>
                <ItemsControl ItemsSource="{Binding Belts}" Focusable="False" AutomationProperties.Name="벨트">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BeltRowVm">
                            <Grid Height="{StaticResource RowHeight}">
                                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Col.Belt}"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Mono}" FontWeight="{StaticResource Semi}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Cw}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Small}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Cw}" Margin="{StaticResource TextRight12}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Ccw}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Small}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ccw}"/>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
