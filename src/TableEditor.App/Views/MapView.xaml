<UserControl x:Class="TableEditor.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TableEditor.App.Views"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine"
             x:Name="Me">
    <!-- 대응표(사양 9.2절): 프로파일, 시퀀스 ID, 표 이름. 머리 줄은 드롭다운 셋. 줄 모양은 태그 화면과 같다 -->
    <UserControl.Resources>
        <!-- 표 이름: 눌러서 시퀀스 화면으로 -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
            <Setter Property="FontSize" Value="{StaticResource Fs.Mid}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="T" Property="TextDecorations" Value="Underline"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowT" DataType="vm:MapRowVm">
            <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent" AllowDrop="True" Drop="OnRowDrop">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Group" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}" Visibility="Collapsed"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.RowRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                        <ColumnDefinition Width="{StaticResource Col.No}"/>
                        <ColumnDefinition Width="{StaticResource Col.Pf}"/>
                        <ColumnDefinition Width="{StaticResource Col.SeqId}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.State}"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" ToolTip="끌기">
                        <Rectangle Width="{StaticResource Grip.W}" Height="{StaticResource Grip.H}" Fill="{StaticResource GripDots}"
                                   HorizontalAlignment="Left" Margin="{StaticResource Grip.Margin}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource ChangeDot}" Height="{StaticResource ChangeDot}" Fill="{StaticResource Accent}" Margin="{StaticResource Gap.R4}"
                                 VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding OrdinalText}" Style="{StaticResource RowNo}"/>
                    </StackPanel>
                    <TextBlock x:Name="Pf" Grid.Column="2" Text="{Binding ProfileText}" ToolTip="{Binding ProfileText}" FontSize="{StaticResource Fs.Mid}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{StaticResource Text.InBox}"/>
                    <ComboBox x:Name="PfEdit" Grid.Column="2" Style="{StaticResource CellDrop}" Visibility="Collapsed" MaxWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Cell.Flush}"
                              ItemsSource="{Binding DataContext.Profiles, ElementName=Me}" SelectedItem="{Binding ProfileDraft}" AutomationProperties.Name="프로파일"/>
                    <TextBlock x:Name="Id" Grid.Column="3" Text="{Binding Id}" ToolTip="{Binding Id}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Mid}"
                               TextTrimming="CharacterEllipsis" Margin="{StaticResource TextRight8}"/>
                    <ComboBox x:Name="IdEdit" Grid.Column="3" Style="{StaticResource CellDrop}" Visibility="Collapsed" MaxWidth="{StaticResource TemplateWidth}"
                              ItemsSource="{Binding IdChoices}" SelectedItem="{Binding IdDraft}" AutomationProperties.Name="시퀀스 ID"/>
                    <Button x:Name="Tb" Grid.Column="4" Content="{Binding Table}" ToolTip="{Binding Table}" Style="{StaticResource Link}"
                            Command="{Binding DataContext.GoTable, ElementName=Me}" CommandParameter="{Binding}" Margin="{StaticResource TextRight8}"/>
                    <ComboBox x:Name="TbEdit" Grid.Column="4" Style="{StaticResource CellDrop}" Visibility="Collapsed" MaxWidth="{StaticResource TemplateWidth}"
                              ItemsSource="{Binding TableChoices}" SelectedItem="{Binding TableDraft}" AutomationProperties.Name="표 이름"/>
                    <Grid Grid.Column="5">
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Status, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource Shown}}">
                            <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                            <TextBlock x:Name="StText" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                    <Setter TargetName="Group" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAny}" Value="True">
                    <Setter TargetName="Pf" Property="Foreground" Value="{StaticResource Text3}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Err}"/>
                    <Setter TargetName="Pf" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Id" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Tb" Property="Opacity" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True"/>
                        <Condition Binding="{Binding IsRaw}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Pf" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PfEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Id" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="IdEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tb" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TbEdit" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Height="{StaticResource BarHeight}" Margin="{StaticResource Pad.Bar}" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding Add}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Faint}" Margin="{StaticResource Gap.R12}"/>
        </DockPanel>

        <Grid Grid.Row="1" Height="{StaticResource HeadHeight}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <Grid Margin="{StaticResource Pad.RowRight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                    <ColumnDefinition Width="{StaticResource Col.No}"/>
                    <ColumnDefinition Width="{StaticResource Col.Pf}"/>
                    <ColumnDefinition Width="{StaticResource Col.SeqId}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Col.State}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="줄" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}"/>
                <TextBlock Grid.Column="2" Text="프로파일" Style="{StaticResource HeadCell}" Margin="{StaticResource Text.InBox}"/>
                <TextBlock Grid.Column="3" Text="시퀀스 ID" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="4" Text="표 이름" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="5" Text="주석" Style="{StaticResource HeadCell}"/>
            </Grid>
        </Grid>

        <ListBox x:Name="Rows" Grid.Row="2" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}"
                 ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowT}" SelectedItem="{Binding Selected}" AllowDrop="True" Drop="OnListDrop"
                 PreviewKeyDown="OnRowsKey" AutomationProperties.Name="대응표 줄"/>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}">
            <TextBlock Text="줄 없음" Style="{StaticResource EmptyWord}"/>
            <Button Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding Add}"/>
        </StackPanel>

        <Border Grid.Row="3" Background="{StaticResource Well}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}"
                Padding="{StaticResource Pad.Detail}" Visibility="{Binding HasSelection, Converter={StaticResource Shown}}">
            <StackPanel>
                <DockPanel Height="{StaticResource SmallButtonHeight}">
                    <Button DockPanel.Dock="Right" Content="삭제" Style="{StaticResource Btn.Small}" Command="{Binding Delete}"/>
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource T.Label}"/>
                </DockPanel>
                <v:DetailView/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
