<UserControl x:Class="TableEditor.App.Views.TagView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TableEditor.App.Views"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:b="clr-namespace:TableEditor.App.Blocks"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine"
             x:Name="Me">
    <UserControl.Resources>
        <!-- 줄 표 한 줄 -->
        <DataTemplate x:Key="RowT" DataType="vm:TagRowVm">
            <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent" AllowDrop="True" Drop="OnRowDrop">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Group" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}" Visibility="Collapsed"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.RowRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                        <ColumnDefinition Width="{StaticResource Col.No}"/>
                        <ColumnDefinition Width="{StaticResource Col.Tag}"/>
                        <ColumnDefinition Width="{StaticResource Col.Profile}"/>
                        <ColumnDefinition Width="{StaticResource Col.Cond}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.Cells}"/>
                        <ColumnDefinition Width="{StaticResource Col.Comment}"/>
                    </Grid.ColumnDefinitions>
                    <!-- 끌기 손잡이 -->
                    <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" ToolTip="끌기">
                        <Rectangle Width="{StaticResource Grip.W}" Height="{StaticResource Grip.H}" Fill="{StaticResource GripDots}"
                                   HorizontalAlignment="Left" Margin="{StaticResource Grip.Margin}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource ChangeDot}" Height="{StaticResource ChangeDot}" Fill="{StaticResource Accent}" Margin="{StaticResource Gap.R4}"
                                 VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding OrdinalText}" Style="{StaticResource T.Faint}" FontFamily="{StaticResource Mono}"/>
                    </StackPanel>
                    <TextBlock x:Name="Tag" Grid.Column="2" Text="{Binding TagText}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Tag}"
                               FontWeight="{StaticResource Semi}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{StaticResource TextRight20}"/>
                    <TextBox x:Name="TagEdit" Grid.Column="2" Style="{StaticResource CellEdit}" Visibility="Collapsed" Margin="{StaticResource TagEdit.Margin}"
                             Text="{Binding TagDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="태그 번호">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.CommitTag, ElementName=Me}" CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape" Command="{Binding DataContext.CancelTag, ElementName=Me}" CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock x:Name="Pf" Grid.Column="3" Text="{Binding ProfileText}" ToolTip="{Binding ProfileText}" FontSize="{StaticResource Fs.Mid}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="{StaticResource TextRight8}"/>
                    <ComboBox x:Name="PfEdit" Grid.Column="3" Style="{StaticResource CellDrop}" Visibility="Collapsed" MaxWidth="{StaticResource ProfileBoxWidth}"
                              ItemsSource="{Binding DataContext.ProfileChoices, ElementName=Me}" SelectedItem="{Binding ProfileDraft}" AutomationProperties.Name="프로파일"/>
                    <Grid Grid.Column="4" ClipToBounds="True" Background="Transparent" Cursor="Hand" ToolTip="조건">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.EditCond, ElementName=Me}" CommandParameter="{Binding}"/>
                        </Grid.InputBindings>
                        <TextBlock Text="—" Style="{StaticResource T.Faint}" Visibility="{Binding Chips.Count, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                    <DockPanel Grid.Column="5" ClipToBounds="True" Margin="{StaticResource Acts.Margin}" LastChildFill="False">
                        <ItemsControl x:Name="Acts" ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource BlockT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center" Padding="{StaticResource Acts.Pad}"/>
                        <Button x:Name="PlusBtn" Content="+" Style="{StaticResource Plus}" Click="OnPlus" Visibility="Collapsed" ToolTip="동작 추가"
                                AutomationProperties.Name="동작 추가"/>
                    </DockPanel>
                    <TextBlock x:Name="Cells" Grid.Column="6" Text="{Binding CellsText}" Style="{StaticResource T.Faint}" FontFamily="{StaticResource Mono}"
                               HorizontalAlignment="Right" Margin="{StaticResource TextRight12}"/>
                    <Grid x:Name="Note" Grid.Column="7">
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Status, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource Shown}}">
                            <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                            <TextBlock x:Name="StText" Text="{Binding Status}" FontSize="{StaticResource Fs.Small}" FontWeight="{StaticResource Semi}"
                                       Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="NoteEdit" Grid.Column="7" Style="{StaticResource InlineBox}" Visibility="Collapsed" LostKeyboardFocus="OnNoteLost"
                             Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="주석">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.CommitComment, ElementName=Me}" CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape" Command="{Binding DataContext.CancelTag, ElementName=Me}" CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                    <Setter TargetName="Group" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRepeat}" Value="True">
                    <Setter TargetName="Tag" Property="Foreground" Value="{StaticResource Text3}"/>
                    <Setter TargetName="Tag" Property="FontWeight" Value="Normal"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAny}" Value="True">
                    <Setter TargetName="Pf" Property="Foreground" Value="{StaticResource Text3}"/>
                </DataTrigger>
                <!-- 범위 규칙(101–120)은 작게 해서 칸에 든다 -->
                <DataTrigger Binding="{Binding IsRange}" Value="True">
                    <Setter TargetName="Tag" Property="FontSize" Value="{StaticResource Fs.Small}"/>
                    <Setter TargetName="Tag" Property="Margin" Value="{StaticResource TextRight8}"/>
                    <Setter TargetName="TagEdit" Property="FontSize" Value="{StaticResource Fs.Small}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFull}" Value="True">
                    <Setter TargetName="Cells" Property="Foreground" Value="{StaticResource Text}"/>
                    <Setter TargetName="Cells" Property="FontWeight" Value="{StaticResource Semi}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Err}"/>
                    <Setter TargetName="Tag" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Pf" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Acts" Property="Opacity" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True"/>
                        <Condition Binding="{Binding IsRaw}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Tag" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TagEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Pf" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PfEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="PlusBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Note" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NoteEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Tag" Property="Opacity" Value="1"/>
                    <Setter TargetName="Acts" Property="Opacity" Value="1"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 태그 보기 한 줄 -->
        <DataTemplate x:Key="LookT" DataType="vm:LookRow">
            <Grid Height="{StaticResource RowHeight}">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Group" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}" Visibility="Collapsed"/>
                <Grid Margin="{StaticResource Look.Pad}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Look.Profile}"/>
                        <ColumnDefinition Width="{StaticResource Look.Cond}"/>
                        <ColumnDefinition Width="{StaticResource Look.No}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Pf" Text="{Binding Profile}" FontSize="{StaticResource Fs.Mid}" VerticalAlignment="Center" Visibility="Hidden"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Column="1" ClipToBounds="True">
                        <TextBlock x:Name="NoCond" Text="—" Style="{StaticResource T.Faint}" Visibility="{Binding Chips.Count, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding OrdinalText}" Style="{StaticResource T.Faint}" FontFamily="{StaticResource Mono}"
                               HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource LookBlockT}" ItemsPanel="{StaticResource Across}"
                                  Focusable="False" VerticalAlignment="Center" ClipToBounds="True" Margin="{StaticResource Acts.Margin}" Padding="{StaticResource Acts.Pad}"/>
                    <TextBlock x:Name="None" Grid.Column="3" Text="없음" Style="{StaticResource T.Faint}" Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGroupStart}" Value="True">
                    <Setter TargetName="Group" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Pf" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding None}" Value="True">
                    <Setter TargetName="None" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="NoCond" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource T.Head}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 거르기 -->
        <DockPanel Height="{StaticResource BarHeight}" Margin="{StaticResource Pad.Bar}" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="태그" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.R8}"/>
            <Grid DockPanel.Dock="Left" Width="{StaticResource TagBoxWidth}" VerticalAlignment="Center" Margin="{StaticResource Gap.R8}">
                <TextBox x:Name="TagBox" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}"
                         Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="태그 거르기"/>
                <TextBlock Text="번호" Style="{StaticResource T.Empty}" HorizontalAlignment="Left" Margin="{StaticResource Gap.L12}" IsHitTestVisible="False"
                           Visibility="{Binding TagFilter, Converter={StaticResource Shown}, ConverterParameter=not}"/>
            </Grid>
            <TextBlock DockPanel.Dock="Left" Text="프로파일" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.Group}"/>
            <ComboBox DockPanel.Dock="Left" Style="{StaticResource Drop}" MinWidth="{StaticResource ProfileBoxWidth}" VerticalAlignment="Center"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding ProfileFilter}" AutomationProperties.Name="프로파일 거르기"/>
            <Border DockPanel.Dock="Left" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                    CornerRadius="{StaticResource R.4}" Margin="{StaticResource Gap.Seg}" VerticalAlignment="Center" ClipToBounds="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="편집" Style="{StaticResource Seg}" GroupName="Mode" IsChecked="{Binding IsEdit}"/>
                    <RadioButton Content="보기" Style="{StaticResource Seg}" GroupName="Mode" IsChecked="{Binding IsLook}"/>
                </StackPanel>
            </Border>
            <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding Add}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Faint}" Margin="{StaticResource Gap.R12}"
                       Visibility="{Binding IsEdit, Converter={StaticResource Shown}}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding LookTitle}" Style="{StaticResource T.Faint}" Margin="{StaticResource Gap.R12}"
                       Visibility="{Binding IsLook, Converter={StaticResource Shown}}"/>
        </DockPanel>

        <!-- 편집: 줄 표 머리 -->
        <Grid Grid.Row="1" Height="{StaticResource HeadHeight}" Visibility="{Binding IsEdit, Converter={StaticResource Shown}}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <Grid Margin="{StaticResource Pad.RowRight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                    <ColumnDefinition Width="{StaticResource Col.No}"/>
                    <ColumnDefinition Width="{StaticResource Col.Tag}"/>
                    <ColumnDefinition Width="{StaticResource Col.Profile}"/>
                    <ColumnDefinition Width="{StaticResource Col.Cond}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Col.Cells}"/>
                    <ColumnDefinition Width="{StaticResource Col.Comment}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="줄" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}"/>
                <TextBlock Grid.Column="2" Text="태그" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                <TextBlock Grid.Column="3" Text="프로파일" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="4" Text="조건" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="5" Text="동작" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="6" Text="칸" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}"/>
                <TextBlock Grid.Column="7" Text="주석" Style="{StaticResource HeadCell}"/>
            </Grid>
        </Grid>

        <!-- 보기: 머리 -->
        <Grid Grid.Row="1" Height="{StaticResource HeadHeight}" Visibility="{Binding IsLook, Converter={StaticResource Shown}}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <Grid Margin="{StaticResource Look.Pad}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Look.Profile}"/>
                    <ColumnDefinition Width="{StaticResource Look.Cond}"/>
                    <ColumnDefinition Width="{StaticResource Look.No}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="프로파일" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="1" Text="조건" Style="{StaticResource HeadCell}"/>
                <TextBlock Grid.Column="2" Text="줄" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                <TextBlock Grid.Column="3" Text="동작" Style="{StaticResource HeadCell}"/>
            </Grid>
        </Grid>

        <ListBox x:Name="Rows" Grid.Row="2" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}" SelectionMode="Extended"
                 ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowT}" AllowDrop="True" Drop="OnListDrop"
                 SelectionChanged="OnSelectionChanged" PreviewKeyDown="OnRowsKey" AutomationProperties.Name="태그 줄"
                 Visibility="{Binding IsEdit, Converter={StaticResource Shown}}"/>
        <ListBox x:Name="Look" Grid.Row="2" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}"
                 ItemsSource="{Binding LookRows}" ItemTemplate="{StaticResource LookT}" AutomationProperties.Name="태그 보기"
                 Visibility="{Binding IsLook, Converter={StaticResource Shown}}"/>

        <!-- 선택 줄 -->
        <Border Grid.Row="3" Background="{StaticResource Well}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}"
                Padding="{StaticResource Pad.Detail}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasSelection}" Value="True"/>
                                <Condition Binding="{Binding IsEdit}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Height="{StaticResource SmallButtonHeight}" Margin="{StaticResource Gap.B8}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="원문" Style="{StaticResource Btn.Small}" Command="{Binding EditRaw}" Margin="{StaticResource Gap.R8}"
                                Visibility="{Binding Selected.IsRaw, Converter={StaticResource Shown}}"/>
                        <Button Content="블록 삭제" Style="{StaticResource Btn.Small}" Command="{Binding DeleteBlock}" Margin="{StaticResource Gap.R8}"
                                Visibility="{Binding Selected.IsRaw, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <Button Content="복제" Style="{StaticResource Btn.Small}" Command="{Binding Duplicate}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="삭제" Style="{StaticResource Btn.Small}" Command="{Binding Delete}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource T.Label}">
                        <Run Text="{Binding DetailTitle, Mode=OneWay}"/><Run Text="{Binding DetailHead, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/>
                    </TextBlock>
                </DockPanel>
                <v:DetailView/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
