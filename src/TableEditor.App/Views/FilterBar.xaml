<UserControl x:Class="TableEditor.App.Views.FilterBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Me">
    <!-- 표 거르기: 번호 칸 + 프로파일. DataContext = FilterVm. 태그·시퀀스 화면이 같이 쓴다 -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding Label, ElementName=Me}" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.R8}"/>
        <Grid Width="{StaticResource TagBoxWidth}" VerticalAlignment="Center" Margin="{StaticResource Gap.R8}">
            <TextBox x:Name="Box" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Label, ElementName=Me}"/>
            <TextBlock Text="번호" Style="{StaticResource T.Empty}" HorizontalAlignment="Left" Margin="{StaticResource Gap.L12}" IsHitTestVisible="False"
                       Visibility="{Binding Text, Converter={StaticResource Shown}, ConverterParameter=not}"/>
        </Grid>
        <TextBlock Text="프로파일" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.Group}"/>
        <ComboBox Style="{StaticResource Drop}" MinWidth="{StaticResource ProfileBoxWidth}" VerticalAlignment="Center"
                  ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="프로파일"/>
    </StackPanel>
</UserControl>
