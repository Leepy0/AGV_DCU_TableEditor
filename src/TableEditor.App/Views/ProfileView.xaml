<UserControl x:Class="TableEditor.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:TableEditor.App.Views"
             xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
             xmlns:chk="clr-namespace:TableEditor.Engine.Check;assembly=TableEditor.Engine"
             x:Name="Me">
    <!-- 프로파일(사양 9.2절): 줄 표 + 오른쪽 호기 지도. 줄 모양은 태그 화면과 같다 -->
    <UserControl.Resources>
        <!-- 숫자 칸 상자: 틀리면 빨간 테 -->
        <Style x:Key="NumEdit" TargetType="TextBox" BasedOn="{StaticResource CellEdit}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="{StaticResource TagEdit.Margin}"/>
        </Style>

        <!-- 후진 FL: 켜진 줄은 색으로(크기는 같은 줄 단추와 같다) -->
        <Style x:Key="FlBtn" TargetType="Button" BasedOn="{StaticResource Btn.Wide}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.BackFl}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowT" DataType="vm:ProfileRowVm">
            <Grid x:Name="Row" Height="{StaticResource RowHeight}" Background="Transparent" AllowDrop="True" Drop="OnRowDrop">
                <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Bottom}"/>
                <Border x:Name="Side" Width="{StaticResource Bar.W}" HorizontalAlignment="Left"/>
                <Grid Margin="{StaticResource Pad.RowRight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                        <ColumnDefinition Width="{StaticResource Col.No}"/>
                        <ColumnDefinition Width="{StaticResource Col.PfShort}"/>
                        <ColumnDefinition Width="{StaticResource Col.Num}"/>
                        <ColumnDefinition Width="{StaticResource Col.Num}"/>
                        <ColumnDefinition Width="{StaticResource Col.Num}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource Col.Note}"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="Transparent" Cursor="SizeAll" PreviewMouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" ToolTip="끌기">
                        <Rectangle Width="{StaticResource Grip.W}" Height="{StaticResource Grip.H}" Fill="{StaticResource GripDots}"
                                   HorizontalAlignment="Left" Margin="{StaticResource Grip.Margin}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource ChangeDot}" Height="{StaticResource ChangeDot}" Fill="{StaticResource Accent}" Margin="{StaticResource Gap.R4}"
                                 VerticalAlignment="Center" Visibility="{Binding IsChanged, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding OrdinalText}" Style="{StaticResource RowNo}"/>
                    </StackPanel>
                    <!-- 프로파일: 색 점 + 이름 -->
                    <DockPanel x:Name="Pf" Grid.Column="2" Margin="{StaticResource TextRight8}">
                        <Ellipse Width="{StaticResource Dot}" Height="{StaticResource Dot}" Fill="{Binding Color, Converter={StaticResource MapBrush}}"
                                 VerticalAlignment="Center" Margin="{StaticResource Gap.R8}"/>
                        <TextBlock DockPanel.Dock="Right" Text="FL" ToolTip="후진 FL" Style="{StaticResource T.Faint}" VerticalAlignment="Center" Margin="{StaticResource Gap.L4}"
                                   Visibility="{Binding BackFl, Converter={StaticResource Shown}}"/>
                        <TextBlock Text="{Binding Profile}" ToolTip="{Binding Profile}" FontSize="{StaticResource Fs.Mid}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ComboBox x:Name="PfEdit" Grid.Column="2" Style="{StaticResource CellDrop}" Visibility="Collapsed" MaxWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Cell.Flush}"
                              ItemsSource="{Binding DataContext.ProfileChoices, ElementName=Me}" SelectedItem="{Binding ProfileDraft}" AutomationProperties.Name="프로파일"/>
                    <TextBlock x:Name="Ty" Grid.Column="3" Text="{Binding TypeText}" Style="{StaticResource T.Mono}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                    <TextBox x:Name="TyEdit" Grid.Column="3" Text="{Binding TypeDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="타입"
                             LostKeyboardFocus="OnNumLost">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NumEdit}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TypeBad}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Err}"/><Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.Commit, ElementName=Me}" CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape" Command="{Binding DataContext.Cancel, ElementName=Me}" CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock x:Name="Fi" Grid.Column="4" Text="{Binding FirstText}" Style="{StaticResource T.Mono}" FontWeight="{StaticResource Semi}"
                               HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                    <TextBox x:Name="FiEdit" Grid.Column="4" Text="{Binding FirstDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="처음"
                             LostKeyboardFocus="OnNumLost">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NumEdit}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FirstBad}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Err}"/><Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.Commit, ElementName=Me}" CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape" Command="{Binding DataContext.Cancel, ElementName=Me}" CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock x:Name="La" Grid.Column="5" Text="{Binding LastText}" Style="{StaticResource T.Mono}" FontWeight="{StaticResource Semi}"
                               HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                    <TextBox x:Name="LaEdit" Grid.Column="5" Text="{Binding LastDraft, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="끝"
                             LostKeyboardFocus="OnNumLost">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource NumEdit}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastBad}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Err}"/><Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding DataContext.Commit, ElementName=Me}" CommandParameter="{Binding}"/>
                            <KeyBinding Key="Escape" Command="{Binding DataContext.Cancel, ElementName=Me}" CommandParameter="{Binding}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <!-- 적재: 없음은 —, 센서·조건은 칩 -->
                    <Grid x:Name="Load" Grid.Column="6" ClipToBounds="True" Margin="{StaticResource Gap.Group}">
                        <TextBlock Text="—" Style="{StaticResource T.Faint}" Visibility="{Binding Chips.Count, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource WideChipT}" ItemsPanel="{StaticResource Across}"
                                      Focusable="False" VerticalAlignment="Center"/>
                    </Grid>
                    <ComboBox x:Name="LoadEdit" Grid.Column="6" Style="{StaticResource CellDrop}" Visibility="Collapsed" Margin="{StaticResource Gap.Group}"
                              MinWidth="{StaticResource ProfileBoxWidth}" ItemsSource="{Binding DataContext.LoadChoices, ElementName=Me}" SelectedItem="{Binding LoadDraft}"
                              AutomationProperties.Name="적재"/>
                    <Grid x:Name="Note" Grid.Column="7">
                        <TextBlock Text="{Binding Comment}" ToolTip="{Binding Comment}" Style="{StaticResource T.Label}" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Status, Converter={StaticResource Shown}, ConverterParameter=not}"/>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}" Visibility="{Binding Status, Converter={StaticResource Shown}}">
                            <Image x:Name="StIcon" Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R6}"/>
                            <TextBlock x:Name="StText" Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static chk:Severity.Error}">
                    <Setter TargetName="StIcon" Property="Source" Value="{StaticResource IconErr}"/>
                    <Setter TargetName="StText" Property="Foreground" Value="{StaticResource Err}"/>
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Err}"/>
                    <Setter TargetName="Pf" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Fi" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="La" Property="Opacity" Value="{StaticResource Dim}"/>
                    <Setter TargetName="Load" Property="Opacity" Value="{StaticResource Dim}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentBg}"/>
                    <Setter TargetName="Side" Property="Background" Value="{StaticResource Accent}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True"/>
                        <Condition Binding="{Binding IsRaw}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Pf" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="PfEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Ty" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="TyEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Fi" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="FiEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="La" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="LaEdit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Load" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="LoadEdit" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 지도 칸: 프로파일 색을 옅게, 고른 줄의 호기는 진하게 -->
        <DataTemplate x:Key="CellT" DataType="vm:MapCellVm">
            <Grid Width="{StaticResource MapCell}" Height="{StaticResource MapCell}" Margin="{StaticResource Map.Gap}" ToolTip="{Binding Tip}" Background="Transparent">
                <Border x:Name="Fill" CornerRadius="{StaticResource R.4}" Background="{Binding Color, Converter={StaticResource MapBrush}}" Opacity="{StaticResource MapTint}"/>
                <Border x:Name="Edge" CornerRadius="{StaticResource R.4}" BorderThickness="{StaticResource Bd.1}" BorderBrush="Transparent"/>
                <TextBlock x:Name="No" Text="{Binding Id}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Tiny}" Foreground="{StaticResource Text2}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                    <Setter TargetName="Edge" Property="BorderBrush" Value="{StaticResource Line}"/>
                    <Setter TargetName="No" Property="Foreground" Value="{StaticResource Text3}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHot}" Value="True">
                    <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                    <Setter TargetName="No" Property="Foreground" Value="{StaticResource OnAccent}"/>
                    <Setter TargetName="No" Property="FontWeight" Value="{StaticResource Semi}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 위 줄 -->
        <DockPanel Grid.ColumnSpan="2" Height="{StaticResource BarHeight}" Margin="{StaticResource Pad.Bar}" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding Add}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Faint}" Margin="{StaticResource Gap.R12}"/>
        </DockPanel>

        <!-- 줄 표 머리 -->
        <Grid Grid.Row="1" Height="{StaticResource HeadHeight}">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
            <Grid Margin="{StaticResource Pad.RowRight}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.Grip}"/>
                    <ColumnDefinition Width="{StaticResource Col.No}"/>
                    <ColumnDefinition Width="{StaticResource Col.PfShort}"/>
                    <ColumnDefinition Width="{StaticResource Col.Num}"/>
                    <ColumnDefinition Width="{StaticResource Col.Num}"/>
                    <ColumnDefinition Width="{StaticResource Col.Num}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource Col.Note}"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="줄" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight8}"/>
                <TextBlock Grid.Column="2" Text="프로파일" Style="{StaticResource HeadCell}" Margin="{StaticResource Pf.Head}"/>
                <TextBlock Grid.Column="3" Text="타입" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                <TextBlock Grid.Column="4" Text="처음" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                <TextBlock Grid.Column="5" Text="끝" Style="{StaticResource HeadCell}" HorizontalAlignment="Right" Margin="{StaticResource TextRight20}"/>
                <TextBlock Grid.Column="6" Text="적재" Style="{StaticResource HeadCell}" Margin="{StaticResource Gap.Group}"/>
                <TextBlock Grid.Column="7" Text="주석" Style="{StaticResource HeadCell}"/>
            </Grid>
        </Grid>

        <ListBox x:Name="Rows" Grid.Row="2" Style="{StaticResource Rows}" ItemContainerStyle="{StaticResource RowItem}"
                 ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowT}" SelectedItem="{Binding Selected}" AllowDrop="True" Drop="OnListDrop"
                 PreviewKeyDown="OnRowsKey" AutomationProperties.Name="프로파일 줄"/>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}">
            <TextBlock Text="줄 없음" Style="{StaticResource EmptyWord}"/>
            <Button Content="추가" Style="{StaticResource Btn.Outline}" Command="{Binding Add}"/>
        </StackPanel>

        <!-- 호기 지도 -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="{StaticResource MapWidth}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Height="{StaticResource HeadHeight}">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.Bottom}"/>
                    <TextBlock Text="호기" Style="{StaticResource HeadCell}" Margin="{StaticResource Pad.MapHead}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellT}" Focusable="False" Margin="{StaticResource Pad.Map}"
                              HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.Name="호기 지도">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="10"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- 선택 줄 -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{StaticResource Well}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.Top}"
                Padding="{StaticResource Pad.Detail}" Visibility="{Binding HasSelection, Converter={StaticResource Shown}}">
            <StackPanel>
                <DockPanel Height="{StaticResource SmallButtonHeight}" Margin="{StaticResource Gap.B8}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="후진 FL" Style="{StaticResource FlBtn}" Command="{Binding ToggleBackFl}" Margin="{StaticResource Gap.R8}"
                                Visibility="{Binding CanBackFl, Converter={StaticResource Shown}}" AutomationProperties.Name="후진 FL"/>
                        <Button Content="적재 조건" Style="{StaticResource Btn.Wide}" Command="{Binding EditLoad}" Margin="{StaticResource Gap.R8}"
                                Visibility="{Binding Selected.IsLoadIf, Converter={StaticResource Shown}}"/>
                        <Button Content="이름 바꾸기" Style="{StaticResource Btn.Wide}" Command="{Binding Rename}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="프로파일 삭제" Style="{StaticResource Btn.Wide}" Command="{Binding DeleteProfile}" Margin="{StaticResource Gap.R8}"/>
                        <Button Content="줄 삭제" Style="{StaticResource Btn.Wide}" Command="{Binding Delete}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DetailTitle}" Style="{StaticResource T.Label}"/>
                </DockPanel>
                <v:DetailView/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
