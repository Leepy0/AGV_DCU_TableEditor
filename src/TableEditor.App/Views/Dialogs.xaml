<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
                    xmlns:gr="clr-namespace:TableEditor.Engine.Grammar;assembly=TableEditor.Engine">
    <!-- 창 안 팝업들. 카드 = 머리(제목) + 몸 + 발(단추, 같은 크기, 강조는 색). 기본 포커스는 FocusManager 로 -->

    <!-- 짧은 확인 -->
    <DataTemplate DataType="{x:Type vm:AskVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Lines}" Margin="{StaticResource Pad.DialogBody}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource Fs.Mid}" Foreground="{StaticResource Text2}" Margin="{StaticResource Gap.B4}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource DialogFoot}">
                    <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AskButton}">
                                <Button x:Name="B" Content="{Binding Label}" Style="{StaticResource Btn.Dialog}" Tag="{Binding Default}"
                                        Command="{Binding DataContext.Press, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Primary}" Value="True">
                                        <Setter TargetName="B" Property="Style" Value="{StaticResource Btn.DialogPrimary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 태그 추가 (목업 tag_add) -->
    <DataTemplate DataType="{x:Type vm:AddVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="태그" Style="{StaticResource FrowLabel}"/>
                    <StackPanel Grid.Column="2" Margin="{StaticResource Gap.B16}">
                        <TextBox x:Name="Tags" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" AutomationProperties.Name="태그">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Err}"/>
                                            <Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Err}" FontSize="{StaticResource Fs.Small}" Margin="{StaticResource Gap.T8}"
                                   Visibility="{Binding HasError, Converter={StaticResource Shown}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="프로파일" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TokBox}" Margin="{StaticResource Gap.B16}">
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tok}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Content="✕" Style="{StaticResource TokX}" AutomationProperties.Name="빼기"
                                                        Command="{Binding DataContext.RemoveProfile, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox Style="{StaticResource TokAdd}" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding AddPick}" AutomationProperties.Name="프로파일 더하기"/>
                        </WrapPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Text="본뜰 줄" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" Margin="{StaticResource Gap.B16}" AutomationProperties.Name="본뜰 줄"/>

                    <TextBlock Grid.Row="3" Text="연속 번호" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="3" Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                            CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="줄마다" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="Run" IsChecked="{Binding PerLine}"/>
                            <RadioButton Content="범위 한 줄" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="Run" IsChecked="{Binding Range}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="미리 보기" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="{StaticResource MatrixHead}" Background="{StaticResource Well}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Matrix.Tag}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="태그" Style="{StaticResource T.Label}" HorizontalAlignment="Center"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ScrollViewer MaxHeight="{StaticResource SignalsMax}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PreviewRow}">
                                                <Grid Height="{StaticResource CheckRowHeight}">
                                                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Top}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource Matrix.Tag}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Mid}" FontWeight="{StaticResource Semi}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Exists}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="C" Text="새 줄" Style="{StaticResource MatrixNew}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                                            <Setter TargetName="C" Property="Text" Value="있음"/>
                                                                            <Setter TargetName="C" Property="Foreground" Value="{StaticResource Text3}"/>
                                                                            <Setter TargetName="C" Property="FontWeight" Value="Normal"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.T8}" TextElement.FontSize="{StaticResource Fs.Small}"
                                    TextElement.Foreground="{StaticResource Text2}">
                            <TextBlock Margin="{StaticResource Gap.R16}">새 줄 <Run Text="{Binding NewCount, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/></TextBlock>
                            <TextBlock>있음 <Run Text="{Binding HasCount, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="{Binding OkText}" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 조건 -->
    <DataTemplate DataType="{x:Type vm:CondVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="확장" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <StackPanel Grid.Column="2" Margin="{StaticResource Gap.B16}">
                        <ItemsControl ItemsSource="{Binding XRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:XRowVm}">
                                    <DockPanel Margin="{StaticResource Gap.B8}">
                                        <Button DockPanel.Dock="Right" Content="빼기" Style="{StaticResource Btn.Small}" VerticalAlignment="Bottom"
                                                Command="{Binding DataContext.RemoveX, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Style="{StaticResource Drop}" MinWidth="{StaticResource ProfileBoxWidth}" Margin="{StaticResource Gap.R8}" VerticalAlignment="Bottom"
                                                      ItemsSource="{Binding Source={x:Static vm:XRowVm.Kinds}}" SelectedItem="{Binding Kind}" AutomationProperties.Name="확장 조건">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type gr:GrammarEntry}">
                                                        <TextBlock Text="{Binding Head}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ItemsControl ItemsSource="{Binding Args}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ArgBox}">
                                                        <StackPanel Margin="{StaticResource Gap.R8}">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.B4}"/>
                                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}"
                                                                     MinWidth="{StaticResource CellEditWidth}" AutomationProperties.Name="{Binding Label}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="확장 추가" Style="{StaticResource Btn.Small}" HorizontalAlignment="Left" Command="{Binding AddX}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="입력" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                        <TextBox Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}" Text="{Binding RawInput}" Margin="{StaticResource Gap.B8}"
                                 Visibility="{Binding HasRawInput, Converter={StaticResource Shown}}" AutomationProperties.Name="입력 조건"/>
                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GroupVm}">
                                    <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}"
                                            Padding="{StaticResource Pad.TokBox}" Margin="{StaticResource Gap.B8}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.B4}">
                                                <Button DockPanel.Dock="Right" Content="빼기" Style="{StaticResource Btn.Small}"
                                                        Command="{Binding DataContext.RemoveGroup, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                <ComboBox Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource FieldMinWidth}"
                                                          ItemsSource="{Binding KindTexts}" SelectedItem="{Binding KindText}" AutomationProperties.Name="묶음"/>
                                            </DockPanel>
                                            <ScrollViewer MaxHeight="{StaticResource SignalsMax}" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Signals}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SignalVm}">
                                                            <ToggleButton Style="{StaticResource TokToggle}" IsChecked="{Binding On}" AutomationProperties.Name="{Binding Name}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L4}"
                                                                               Visibility="{Binding Note, Converter={StaticResource Shown}}"/>
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="묶음 추가" Style="{StaticResource Btn.Small}" HorizontalAlignment="Left" Command="{Binding AddGroup}"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 원문(고급) -->
    <DataTemplate DataType="{x:Type vm:RawVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <TextBox Margin="{StaticResource Pad.DialogBody}" Height="{StaticResource RawHeight}" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}"
                         FontSize="{StaticResource Fs.Small}" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="원문"/>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
