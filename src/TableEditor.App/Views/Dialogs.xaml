<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TableEditor.App.ViewModels"
                    xmlns:gr="clr-namespace:TableEditor.Engine.Grammar;assembly=TableEditor.Engine">
    <!-- 창 안 팝업들. 카드 = 머리(제목) + 몸 + 발(단추, 같은 크기, 강조는 색). 기본 포커스는 FocusManager 로 -->

    <!-- 짧은 확인 -->
    <DataTemplate DataType="{x:Type vm:AskVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Lines}" Margin="{StaticResource Pad.DialogBody}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" FontSize="{StaticResource Fs.Mid}" Foreground="{StaticResource Text2}" Margin="{StaticResource Gap.B4}"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource DialogFoot}">
                    <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AskButton}">
                                <Button x:Name="B" Content="{Binding Label}" Style="{StaticResource Btn.Dialog}" Tag="{Binding Default}"
                                        Command="{Binding DataContext.Press, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Primary}" Value="True">
                                        <Setter TargetName="B" Property="Style" Value="{StaticResource Btn.DialogPrimary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 태그 추가 (목업 tag_add) -->
    <DataTemplate DataType="{x:Type vm:AddVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="태그" Style="{StaticResource FrowLabel}"/>
                    <StackPanel Grid.Column="2" Margin="{StaticResource Gap.B16}">
                        <TextBox x:Name="Tags" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" AutomationProperties.Name="태그">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource EditBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource Err}"/>
                                            <Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource Err}" FontSize="{StaticResource Fs.Small}" Margin="{StaticResource Gap.T8}"
                                   Visibility="{Binding HasError, Converter={StaticResource Shown}}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="프로파일" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource TokBox}" Margin="{StaticResource Gap.B16}">
                        <WrapPanel>
                            <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tok}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Content="✕" Style="{StaticResource TokX}" AutomationProperties.Name="삭제"
                                                        Command="{Binding DataContext.RemoveProfile, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox Style="{StaticResource TokAdd}" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding AddPick}" AutomationProperties.Name="프로파일 더하기"/>
                        </WrapPanel>
                    </Border>

                    <TextBlock Grid.Row="2" Text="본뜰 줄" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" Margin="{StaticResource Gap.B16}" AutomationProperties.Name="본뜰 줄"/>

                    <TextBlock Grid.Row="3" Text="연속 번호" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="3" Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                            CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="줄마다" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="Run" IsChecked="{Binding PerLine}"/>
                            <RadioButton Content="범위 한 줄" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="Run" IsChecked="{Binding Range}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="미리 보기" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <StackPanel Grid.Row="4" Grid.Column="2">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}" ClipToBounds="True">
                            <StackPanel>
                                <Grid Height="{StaticResource MatrixHead}" Background="{StaticResource Well}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Matrix.Tag}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="태그" Style="{StaticResource T.Label}" HorizontalAlignment="Center"/>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource T.Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ScrollViewer MaxHeight="{StaticResource SignalsMax}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Preview}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PreviewRow}">
                                                <Grid Height="{StaticResource CheckRowHeight}">
                                                    <Border BorderBrush="{StaticResource RowLine}" BorderThickness="{StaticResource Bd.Top}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="{StaticResource Matrix.Tag}"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Tag}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Mid}" FontWeight="{StaticResource Semi}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Exists}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock x:Name="C" Text="새 줄" Style="{StaticResource MatrixNew}"/>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                                            <Setter TargetName="C" Property="Text" Value="있음"/>
                                                                            <Setter TargetName="C" Property="Foreground" Value="{StaticResource Text3}"/>
                                                                            <Setter TargetName="C" Property="FontWeight" Value="Normal"/>
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.T8}" TextElement.FontSize="{StaticResource Fs.Small}"
                                    TextElement.Foreground="{StaticResource Text2}">
                            <TextBlock Margin="{StaticResource Gap.R16}">새 줄 <Run Text="{Binding NewCount, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/></TextBlock>
                            <TextBlock>있음 <Run Text="{Binding HasCount, Mode=OneWay}" FontWeight="{StaticResource Semi}" Foreground="{StaticResource Text}"/></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="{Binding OkText}" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 입력 조건 한 칸(묶음 여러 개). 조건·적재 조건·수동 조건 팝업이 같이 쓴다 -->
    <DataTemplate DataType="{x:Type vm:InputVm}">
        <StackPanel>
            <TextBox Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}" Text="{Binding RawInput}" Margin="{StaticResource Gap.B8}"
                     Visibility="{Binding HasRawInput, Converter={StaticResource Shown}}" AutomationProperties.Name="입력 조건"/>
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:GroupVm}">
                        <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}"
                                Padding="{StaticResource Pad.TokBox}" Margin="{StaticResource Gap.B8}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="{StaticResource Gap.B4}">
                                    <Button DockPanel.Dock="Right" Content="삭제" Style="{StaticResource Btn.Small}"
                                            Command="{Binding DataContext.RemoveGroup, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <ComboBox Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource FieldMinWidth}"
                                              ItemsSource="{Binding KindTexts}" SelectedItem="{Binding KindText}" AutomationProperties.Name="묶음"/>
                                </DockPanel>
                                <ScrollViewer MaxHeight="{StaticResource SignalsMax}" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Signals}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SignalVm}">
                                                <ToggleButton Style="{StaticResource TokToggle}" IsChecked="{Binding On}" AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource BlockSmall}" Margin="{StaticResource Gap.L4}"
                                                                   Visibility="{Binding Note, Converter={StaticResource Shown}}"/>
                                                    </StackPanel>
                                                </ToggleButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
                <Button Content="묶음 추가" Style="{StaticResource Btn.Small}" Command="{Binding AddGroup}"/>
                <ToggleButton Content="전체" Style="{StaticResource TokToggle}" IsChecked="{Binding ShowAll}" Margin="{StaticResource Gap.L12}"
                              Visibility="{Binding CanToggle, Converter={StaticResource Shown}}" AutomationProperties.Name="전체"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- 조건 -->
    <DataTemplate DataType="{x:Type vm:CondVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="차량 상태" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <StackPanel Grid.Column="2" Margin="{StaticResource Gap.B16}">
                        <ItemsControl ItemsSource="{Binding XRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:XRowVm}">
                                    <DockPanel Margin="{StaticResource Gap.B8}">
                                        <Button DockPanel.Dock="Right" Content="삭제" Style="{StaticResource Btn.Small}" VerticalAlignment="Bottom"
                                                Command="{Binding DataContext.RemoveX, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <ComboBox Style="{StaticResource Drop}" MinWidth="{StaticResource ProfileBoxWidth}" Margin="{StaticResource Gap.R8}" VerticalAlignment="Bottom"
                                                      ItemsSource="{Binding Items}" SelectedItem="{Binding Kind}" AutomationProperties.Name="차량 상태">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type gr:GrammarEntry}">
                                                        <TextBlock Text="{Binding Head}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <ToggleButton Style="{StaticResource TokToggle}" Content="반전" IsChecked="{Binding Negate}" IsEnabled="{Binding CanNegate}"
                                                          VerticalAlignment="Bottom" Margin="{StaticResource Gap.R8}" AutomationProperties.Name="반전"/>
                                            <ItemsControl ItemsSource="{Binding Args}" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ArgBox}">
                                                        <StackPanel Margin="{StaticResource Gap.R8}">
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="{StaticResource Gap.B4}"/>
                                                            <ComboBox Style="{StaticResource Drop}" MinWidth="{StaticResource CellEditWidth}" ItemsSource="{Binding Options}" SelectedItem="{Binding Text}"
                                                                      Visibility="{Binding IsList, Converter={StaticResource Shown}}" AutomationProperties.Name="{Binding Label}"/>
                                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}" MinWidth="{StaticResource CellEditWidth}"
                                                                     Visibility="{Binding IsBox, Converter={StaticResource Shown}}" ToolTip="{Binding Range}" AutomationProperties.Name="{Binding Label}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource EditBox}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Invalid}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource Err}"/>
                                                                                <Setter Property="BorderThickness" Value="{StaticResource Bd.Pick}"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource Err}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="상태 추가" Style="{StaticResource Btn.Small}" HorizontalAlignment="Left" Command="{Binding AddX}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="입력" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding In}" Focusable="False"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 적재 조건: 이름(읽기) + 조건 둘 -->
    <DataTemplate DataType="{x:Type vm:LoadVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Style="{StaticResource DialogTitle}"><Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontWeight="Normal" Foreground="{StaticResource Text2}"/></TextBlock>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding First.Label}" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <ContentControl Grid.Column="2" Content="{Binding First}" Focusable="False" Margin="{StaticResource Gap.B16}"/>
                    <TextBlock Grid.Row="1" Text="{Binding Second.Label}" Style="{StaticResource FrowLabel}" VerticalAlignment="Top" Margin="{StaticResource Gap.T8}"/>
                    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding Second}" Focusable="False"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 수동 조건: 입력 / 키 / 없음 -->
    <DataTemplate DataType="{x:Type vm:ManCondVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="종류" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                            CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="입력" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="ManCond" IsChecked="{Binding IsInput}"/>
                            <RadioButton Content="키" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="ManCond" IsChecked="{Binding IsKey}"/>
                            <RadioButton Content="없음" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="ManCond" IsChecked="{Binding IsNone}"/>
                        </StackPanel>
                    </Border>
                    <ContentControl Grid.Row="1" Grid.Column="2" Content="{Binding In}" Focusable="False" Visibility="{Binding IsInput, Converter={StaticResource Shown}}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource ProfileBoxWidth}"
                              ItemsSource="{Binding Source={x:Static vm:ManCondVm.Keys}}" SelectedItem="{Binding Key}" AutomationProperties.Name="키"
                              Visibility="{Binding IsKey, Converter={StaticResource Shown}}"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 수동 카드 추가: 프로파일, 모드, 본뜰 사슬 -->
    <DataTemplate DataType="{x:Type vm:CardAddVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="프로파일" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Gap.B16}"
                              ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="프로파일"/>
                    <TextBlock Grid.Row="1" Text="모드" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="1" Grid.Column="2" Height="{StaticResource ControlHeight}" BorderBrush="{StaticResource Line2}" BorderThickness="{StaticResource Bd.1}"
                            CornerRadius="{StaticResource R.4}" HorizontalAlignment="Left" ClipToBounds="True" Margin="{StaticResource Gap.B16}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="IDLE" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="CardMode" IsChecked="{Binding IsIdle}"/>
                            <RadioButton Content="JOG" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="CardMode" IsChecked="{Binding IsJog}"/>
                            <RadioButton Content="ANY" Style="{StaticResource Seg}" Width="{StaticResource ButtonWidth}" GroupName="CardMode" IsChecked="{Binding IsAny}"
                                         Visibility="{Binding AnyOk, Converter={StaticResource Shown}}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="2" Text="본뜰 사슬" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Gap.B16}"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding Template}" AutomationProperties.Name="본뜰 사슬"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="추가" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 스텝·동작 추가, 명령 바꾸기: 검색 → 분류 버튼 한 줄(같은 크기, 고른 것은 색) → 명령 → 인자 설명 → 미리 보기 -->
    <DataTemplate DataType="{x:Type vm:StepVm}">
        <Border Style="{StaticResource DialogCard}" Width="860">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="검색" Style="{StaticResource FrowLabel}"/>
                    <TextBox Grid.Column="2" Style="{StaticResource Box}" Margin="{StaticResource Gap.B16}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="검색"/>
                    <TextBlock Grid.Row="1" Text="분류" Style="{StaticResource FrowLabel}"/>
                    <ListBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="{StaticResource Gap.B16}"
                             BorderThickness="{StaticResource Bd.1}" BorderBrush="{StaticResource Line2}" Background="Transparent" AutomationProperties.Name="분류"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="{StaticResource ControlHeight}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text2}"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Well}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBg}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="{StaticResource Semi}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="명령" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Gap.B16}"
                              ItemsSource="{Binding Commands}" SelectedItem="{Binding Command}" AutomationProperties.Name="명령">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="인자" Style="{StaticResource FrowLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Note}" Foreground="{StaticResource Text2}" VerticalAlignment="Top" TextWrapping="Wrap"
                               MinHeight="44" Margin="{StaticResource Gap.B16}"/>
                    <TextBlock Grid.Row="4" Text="미리 보기" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Row="4" Grid.Column="2" Height="{StaticResource CodeHeight}" Background="{StaticResource Code}" CornerRadius="{StaticResource R.4}"
                            Padding="{StaticResource Pad.Box}">
                        <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource Mono}" FontSize="{StaticResource Fs.Small}" Foreground="{StaticResource CodeText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <TextBlock Grid.Row="5" Text="버릴 인자" Style="{StaticResource FrowLabel}" Margin="{StaticResource Gap.T12}" Visibility="{Binding HasDrops, Converter={StaticResource Shown}}"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Drops}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Err}" VerticalAlignment="Center"
                               Margin="{StaticResource Gap.T12}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDrops, Converter={StaticResource Shown}}"/>
                    <TextBlock Grid.Row="6" Text="주석 확인" Style="{StaticResource FrowLabel}" Margin="{StaticResource Gap.T12}" Visibility="{Binding HasComment, Converter={StaticResource Shown}}"/>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding Comment}" Foreground="{StaticResource Warn}" VerticalAlignment="Center"
                               Margin="{StaticResource Gap.T12}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasComment, Converter={StaticResource Shown}}"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="{Binding OkText}" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 시퀀스 표 추가: 이름 + 대응표 줄(프로파일, 시퀀스 ID) -->
    <DataTemplate DataType="{x:Type vm:SeqTableVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="이름" Style="{StaticResource FrowLabel}"/>
                    <TextBox Grid.Column="2" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}" Margin="{StaticResource Gap.B16}"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="이름" Tag="{StaticResource True}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Row="1" Text="프로파일" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}" Margin="{StaticResource Gap.B16}"
                              ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="프로파일"/>
                    <TextBlock Grid.Row="2" Text="시퀀스 ID" Style="{StaticResource FrowLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" Style="{StaticResource Drop}" HorizontalAlignment="Left" MinWidth="{StaticResource TemplateWidth}"
                              ItemsSource="{Binding Ids}" SelectedItem="{Binding Id}" AutomationProperties.Name="시퀀스 ID"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="추가" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- IO 맵 신호의 프로파일 -->
    <DataTemplate DataType="{x:Type vm:PfPickVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}" FontFamily="{StaticResource Mono}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="프로파일" Style="{StaticResource FrowLabel}"/>
                    <Border Grid.Column="2" Style="{StaticResource TokBox}">
                        <WrapPanel>
                            <TextBlock Text="모두" Style="{StaticResource T.Faint}" VerticalAlignment="Center" Margin="{StaticResource Gap.R16}"
                                       Visibility="{Binding IsAll, Converter={StaticResource Shown}}"/>
                            <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tok}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                <Button Content="✕" Style="{StaticResource TokX}" AutomationProperties.Name="삭제"
                                                        Command="{Binding DataContext.RemoveProfile, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ComboBox Style="{StaticResource TokAdd}" ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding AddPick}" AutomationProperties.Name="프로파일 더하기"/>
                        </WrapPanel>
                    </Border>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 이름 하나 -->
    <DataTemplate DataType="{x:Type vm:NameVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="이름" Style="{StaticResource FrowLabel}" Margin="0"/>
                    <TextBox Grid.Column="2" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="이름">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="{Binding OkText}" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 저장 사유 한 줄: Enter = 저장, 빈 글이면 저장이 흐림 -->
    <DataTemplate DataType="{x:Type vm:ReasonVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="사유" Style="{StaticResource FrowLabel}" Margin="0"/>
                    <TextBox Grid.Column="2" Style="{StaticResource EditBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                             AutomationProperties.Name="사유">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="저장" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 작성자: 이름·메일 -->
    <DataTemplate DataType="{x:Type vm:AuthorVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Frow.Label}"/>
                        <ColumnDefinition Width="{StaticResource Frow.Gap}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="이름" Style="{StaticResource FrowLabel}"/>
                    <TextBox Grid.Column="2" Style="{StaticResource EditBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Gap.B16}"
                             AutomationProperties.Name="이름"/>
                    <TextBlock Grid.Row="1" Text="메일" Style="{StaticResource FrowLabel}" Margin="0"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource EditBox}" Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="메일">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding Ok}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="저장" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 확인(값 위주): 라벨 + 값 줄, 단추(기본 포커스 = 취소) -->
    <DataTemplate DataType="{x:Type vm:FactsVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <ItemsControl ItemsSource="{Binding Facts}" Margin="{StaticResource Pad.DialogBody}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:Fact}">
                            <Grid MinHeight="{StaticResource FactRowHeight}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource Fact.Label}"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" FontSize="{StaticResource Fs.Mid}"/>
                                <TextBlock x:Name="V" Grid.Column="1" Text="{Binding Value}" FontWeight="{StaticResource Semi}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Mono}" Value="True">
                                    <Setter TargetName="V" Property="FontFamily" Value="{StaticResource Mono}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource DialogFoot}">
                    <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" ItemsPanel="{StaticResource Across}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AskButton}">
                                <Button x:Name="B" Content="{Binding Label}" Style="{StaticResource Btn.Dialog}" Tag="{Binding Default}"
                                        Command="{Binding DataContext.Press, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Primary}" Value="True">
                                        <Setter TargetName="B" Property="Style" Value="{StaticResource Btn.DialogPrimary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 받기 충돌: 파일 목록 + [내 것 보관하고 원격 받기][그대로 두기](기본 포커스) -->
    <DataTemplate DataType="{x:Type vm:ConflictVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource T.Label}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                    </DockPanel>
                </Border>
                <Border Margin="{StaticResource Pad.DialogBody}" Background="{StaticResource Well}" BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}"
                        CornerRadius="{StaticResource R.4}">
                    <ScrollViewer MaxHeight="{StaticResource FileListMax}" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Files}" Margin="{StaticResource Pad.FileList}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Height="{StaticResource FactRowHeight}">
                                        <Image Style="{StaticResource Icon}" Source="{StaticResource IconWarn}" Margin="{StaticResource Gap.R8}"/>
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" FontSize="{StaticResource Fs.Small}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="내 것 보관하고 원격 받기" Style="{StaticResource Btn.DialogWide}" Command="{Binding Keep}"/>
                        <Button Content="그대로 두기" Style="{StaticResource Btn.DialogWidePrimary}" Command="{Binding Cancel}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 코어 버전 고르기: 지금 버전, 목록(받는 중 / 오프라인) -->
    <DataTemplate DataType="{x:Type vm:VersionsVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource T.Label}"><Run Text="지금 "/><Run Text="{Binding Current, Mode=OneWay}" FontWeight="{StaticResource Semi}"/></TextBlock>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                    </DockPanel>
                </Border>
                <Grid Margin="{StaticResource Pad.DialogBody}" MinHeight="{StaticResource SignalsMax}">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="{StaticResource Bd.1}" CornerRadius="{StaticResource R.4}">
                        <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding Selected}" MaxHeight="{StaticResource VersionListMax}" BorderThickness="0"
                                 FontFamily="{StaticResource Mono}" AutomationProperties.Name="코어 버전"/>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Width="{StaticResource EmptyButtonWidth}" Height="{StaticResource Bar.W}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource Shown}}"/>
                    <TextBlock Text="오프라인" Style="{StaticResource T.Empty}" Visibility="{Binding IsOffline, Converter={StaticResource Shown}}"/>
                    <TextBlock Text="버전 없음" Style="{StaticResource T.Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource Shown}}"/>
                </Grid>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}" Tag="{StaticResource True}"/>
                        <Button Content="고르기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 원문(고급) -->
    <DataTemplate DataType="{x:Type vm:RawVm}">
        <Border Style="{StaticResource DialogCard}">
            <StackPanel>
                <Border Height="{StaticResource DialogHeadHeight}" Padding="{StaticResource Pad.DialogHead}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DialogTitle}"/>
                </Border>
                <TextBox Margin="{StaticResource Pad.DialogBody}" Height="{StaticResource RawHeight}" Style="{StaticResource EditBox}" FontFamily="{StaticResource Mono}"
                         FontSize="{StaticResource Fs.Small}" AcceptsReturn="True" AcceptsTab="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="원문"/>
                <Border Style="{StaticResource DialogFoot}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="취소" Style="{StaticResource Btn.Dialog}" Command="{Binding Cancel}"/>
                        <Button Content="바꾸기" Style="{StaticResource Btn.DialogPrimary}" Command="{Binding Ok}" Tag="{StaticResource True}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
